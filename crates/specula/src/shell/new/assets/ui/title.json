{
  "format": "specula.ui.screen.v1",
  "name": "title",
  "input": "menu",
  "layer": 10,
  "modal": true,
  "focus": "start",
  "notes": "Shown when the game opens; it holds the clock until Start. Actions the engine knows (docs/design/FIRST_HOUR.md): start, open:NAME, quit. Words: assets/strings/<locale>.json. State: game.title.",
  "root": {
    "type": "box",
    "children": [
      {
        "type": "box", "anchor": "center", "layout": "column", "align": "center", "gap": 18,
        "children": [
          { "type": "panel", "style": "veil", "children": [ { "type": "label", "text": "{game.title}", "role": "title", "text_align": "center" } ] },
          {
            "type": "panel", "style": "menu", "width": "16em", "max_width": "96%", "layout": "column", "align": "stretch", "gap": 10,
            "children": [
              { "type": "button", "id": "start", "style": "primary", "text": "@title.start", "action": "start" },
              { "type": "button", "id": "settings", "text": "@title.settings", "action": "open:settings" },
              { "type": "button", "id": "quit", "text": "@title.quit", "action": "quit" }
            ]
          }
        ]
      }
    ]
  }
}
