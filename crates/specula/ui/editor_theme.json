{
  "format": "specula.ui.theme.v1",
  "name": "specula_editor",
  "notes": "The engine's editor (docs/design/EDITOR.md): the review screen's neutral slate so any game's art reads true beside it, compact rows for a desktop editor (gamepad focus still reaches every control), Specula cyan for focus, the active tool and the selection, amber for refusals. Sizes are logical px at 1280x800 (scale 1).",
  "colors": {
    "slate": "#262b33",
    "slate_hi": "#2f353f",
    "slate_lo": "#1e2228",
    "edge": "#4c5562",
    "dark": "#12151a",
    "recess": "#171a1f",
    "text": "#ece6d6",
    "text_dim": "#b9b2a1",
    "text_faint": "#8e897d",
    "accent": "#3fe0d0",
    "accent_deep": "#1a8f9e",
    "warn": "#ffc46b",
    "bad": "#ff8a7a",
    "good": "#8fe39a"
  },
  "spacing": {
    "xs": 4,
    "s": 8,
    "m": 12,
    "l": 20
  },
  "roles": {
    "body": {
      "font": "ui",
      "size": 14,
      "color": "text",
      "line_height": 1.15
    },
    "small": {
      "font": "ui",
      "size": 12.5,
      "color": "text_dim",
      "line_height": 1.15
    },
    "heading": {
      "font": "ui_bold",
      "size": 15,
      "color": "text"
    },
    "title": {
      "font": "ui_bold",
      "size": 22,
      "color": "text"
    },
    "button": {
      "font": "ui_bold",
      "size": 13.5,
      "color": "text"
    },
    "keycap": {
      "font": "ui_bold",
      "size": 13,
      "color": "text"
    },
    "warn": {
      "font": "ui",
      "size": 13,
      "color": "warn"
    },
    "good": {
      "font": "ui",
      "size": 13,
      "color": "good"
    }
  },
  "boxes": {
    "panel": {
      "fill": [
        "slate_hi",
        "slate_lo"
      ],
      "border": 1,
      "border_color": [
        "edge",
        "dark"
      ],
      "radius": 6,
      "padding": [
        8,
        12
      ]
    },
    "inset": {
      "fill": [
        "recess",
        "#1d2026"
      ],
      "border": 1,
      "border_color": [
        "dark",
        "#353b45"
      ],
      "radius": 4,
      "padding": 6
    },
    "keycap": {
      "fill": [
        "#525b68",
        "#3a414c"
      ],
      "border": 1,
      "border_color": [
        "#7a8392",
        "dark"
      ],
      "radius": 4,
      "padding": [
        1,
        6
      ]
    },
    "button": {
      "fill": [
        "#3d444f",
        "#2c3139"
      ],
      "border": 1,
      "border_color": [
        "#5f6876",
        "dark"
      ],
      "radius": 5
    },
    "button_hot": {
      "fill": [
        "#44505a",
        "#2f3a41"
      ],
      "border": 1.5,
      "border_color": [
        "accent",
        "accent_deep"
      ],
      "radius": 5
    },
    "button_down": {
      "fill": [
        "#22272e",
        "#2c3139"
      ],
      "border": 1,
      "border_color": [
        "dark",
        "accent_deep"
      ],
      "radius": 5
    },
    "button_off": {
      "fill": [
        "#2a2e35",
        "#24282e"
      ],
      "border": 1,
      "border_color": [
        "#3a404a",
        "#1a1d22"
      ],
      "radius": 5
    },
    "primary": {
      "fill": [
        "#1f5e66",
        "#164a52"
      ],
      "border": 1,
      "border_color": [
        "accent",
        "#0e3338"
      ],
      "radius": 5
    },
    "primary_hot": {
      "fill": [
        "#26737c",
        "#1a5a63"
      ],
      "border": 2,
      "border_color": [
        "#b8fff6",
        "accent"
      ],
      "radius": 5
    },
    "tooltip": {
      "fill": "#15181df2",
      "border": 1,
      "border_color": "edge",
      "radius": 4,
      "padding": [
        6,
        10
      ]
    },
    "toast": {
      "fill": [
        "#2b3038f0",
        "#20242af0"
      ],
      "border": 1,
      "border_color": [
        "edge",
        "dark"
      ],
      "radius": 6,
      "padding": [
        7,
        14
      ]
    },
    "divider": {
      "fill": "#4c556280"
    },
    "bar": {
      "fill": [
        "#2a3039",
        "#1f242b"
      ],
      "border": 1,
      "border_color": [
        "#4c5562",
        "dark"
      ],
      "radius": 0,
      "padding": [
        5,
        10
      ]
    },
    "dock": {
      "fill": [
        "#262b33",
        "#1e2228"
      ],
      "border": 1,
      "border_color": [
        "edge",
        "dark"
      ],
      "radius": 0,
      "padding": [
        8,
        8
      ]
    },
    "field": {
      "fill": [
        "#191c21",
        "#20242a"
      ],
      "border": 1,
      "border_color": [
        "dark",
        "#3a414c"
      ],
      "radius": 3
    },
    "field_hot": {
      "fill": [
        "#1c2226",
        "#232a30"
      ],
      "border": 1.5,
      "border_color": [
        "accent",
        "accent_deep"
      ],
      "radius": 3
    },
    "row": {
      "fill": "#00000000",
      "radius": 3
    },
    "row_hot": {
      "fill": "#ffffff14",
      "border": 1,
      "border_color": [
        "accent_deep",
        "accent_deep"
      ],
      "radius": 3
    },
    "row_on": {
      "fill": [
        "#1f5e66",
        "#164a52"
      ],
      "border": 1,
      "border_color": [
        "accent",
        "#0e3338"
      ],
      "radius": 3
    }
  },
  "buttons": {
    "default": {
      "normal": {
        "box": "button",
        "text": "text"
      },
      "hover": {
        "box": "button_hot",
        "text": "#b8fff6"
      },
      "focused": {
        "box": "button_hot",
        "text": "#b8fff6"
      },
      "pressed": {
        "box": "button_down",
        "text": "accent"
      },
      "disabled": {
        "box": "button_off",
        "text": "text_faint"
      },
      "role": "button",
      "padding": [
        5,
        10
      ],
      "min_height": 30
    },
    "primary": {
      "normal": {
        "box": "primary",
        "text": "#f4fffd"
      },
      "hover": {
        "box": "primary_hot",
        "text": "#ffffff"
      },
      "focused": {
        "box": "primary_hot",
        "text": "#ffffff"
      },
      "pressed": {
        "box": "button_down",
        "text": "accent"
      },
      "disabled": {
        "box": "button_off",
        "text": "text_faint"
      },
      "role": "button",
      "padding": [
        5,
        10
      ],
      "min_height": 30
    },
    "small": {
      "normal": {
        "box": "button",
        "text": "text"
      },
      "hover": {
        "box": "button_hot",
        "text": "#b8fff6"
      },
      "focused": {
        "box": "button_hot",
        "text": "#b8fff6"
      },
      "pressed": {
        "box": "button_down",
        "text": "accent"
      },
      "disabled": {
        "box": "button_off",
        "text": "text_faint"
      },
      "role": "button",
      "padding": [
        2,
        7
      ],
      "min_height": 24
    },
    "field": {
      "normal": {
        "box": "field",
        "text": "text"
      },
      "hover": {
        "box": "field_hot",
        "text": "#b8fff6"
      },
      "focused": {
        "box": "field_hot",
        "text": "#b8fff6"
      },
      "pressed": {
        "box": "field_hot",
        "text": "accent"
      },
      "disabled": {
        "box": "field",
        "text": "text_faint"
      },
      "role": "body",
      "padding": [
        3,
        6
      ],
      "min_height": 26
    },
    "row": {
      "normal": {
        "box": "row",
        "text": "text"
      },
      "hover": {
        "box": "row_hot",
        "text": "#b8fff6"
      },
      "focused": {
        "box": "row_hot",
        "text": "#b8fff6"
      },
      "pressed": {
        "box": "row_on",
        "text": "accent"
      },
      "disabled": {
