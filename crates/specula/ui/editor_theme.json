  "focus": {
    "color": "accent",
    "width": 2,
    "gap": 2
  },
  "tooltip": {
    "box": "tooltip",
    "role": "small",
    "delay_s": 0.45,
    "max_width": 280
  },
  "toast": {
    "box": "toast",
    "role": "body",
    "info": "text_dim",
    "good": "accent",
    "warn": "warn",
    "threat": "bad",
    "duration_s": 3.5,
    "fade_s": 0.5
  },
  "threat": {
    "label_box": "tooltip"
  },
  "keycap": {
    "box": "keycap",
    "role": "keycap",
    "min_width": 24
  },
  "dim": "#05080fb0",
  "scale": {
    "reference": [
      1280,
      800
    ],
    "reference_ppi": 215,
    "min": 0.75,
    "max": 4
  },
  "check": {
    "min_cap_px": 9,
    "min_touch_px": 24,
    "contrast_body": 4.5,
    "contrast_large": 3,
    "large_text_px": 24
  },
  "scene": [
    "#0b1020",
    "#2a3448",
