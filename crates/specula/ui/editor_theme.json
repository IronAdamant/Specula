    "row_on": {
      "normal": {
        "box": "row_on",
        "text": "#f4fffd"
      },
      "hover": {
        "box": "row_on",
        "text": "#ffffff"
      },
      "focused": {
        "box": "row_on",
        "text": "#ffffff"
      },
      "pressed": {
        "box": "row_on",
        "text": "accent"
      },
      "disabled": {
        "box": "row_on",
