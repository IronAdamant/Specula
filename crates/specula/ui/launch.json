                    "role": "body",
                    "wrap": true,
                    "width": "fill"
                  }
                ]
              },
              {
                "type": "label",
                "text": "{type_note}",
                "role": "small",
                "wrap": true
              },
              {
                "type": "box",
                "layout": "row",
                "align": "center",
                "gap": 10,
                "children": [
                  {
                    "type": "box",
                    "width": "fill"
                  },
                  {
                    "type": "button",
                    "id": "st_cancel",
                    "text": "Cancel",
                    "action": "start_cancel"
                  },
                  {
                    "type": "button",
                    "id": "st_ok",
                    "style": "primary",
                    "text": "{type_ok}",
                    "action": "start_ok",
                    "enabled": "can_ok"
                  }
                ]
              }
            ]
          },
          {
            "type": "box",
            "layout": "column",
            "align": "stretch",
            "gap": 8,
            "visible": "forgetting",
            "children": [
              {
                "type": "label",
                "text": "{forget_line}",
                "role": "body",
                "wrap": true
              },
              {
                "type": "box",
                "layout": "row",
                "align": "center",
                "gap": 10,
                "children": [
                  {
                    "type": "box",
                    "width": "fill"
                  },
                  {
                    "type": "button",
                    "id": "st_keep",
                    "text": "Keep it",
                    "action": "start_cancel"
                  },
                  {
                    "type": "button",
                    "id": "st_forget_yes",
                    "text": "Take it off the list",
                    "action": "start_forget_yes"
                  }
                ]
              }
            ]
          },
          {
            "type": "label",
            "text": "{world_note}",
            "role": "warn",
            "visible": "world_note",
            "wrap": true
          },
          {
            "type": "label",
            "text": "{status_line}",
            "role": "good",
            "visible": [
              "status_line",
              "status_good"
            ],
            "wrap": true
          },
          {
            "type": "label",
            "text": "{status_line}",
            "role": "warn",
            "visible": [
              "status_line",
              "!status_good"
            ],
            "wrap": true
          },
          {
            "type": "label",
            "text": "From a terminal, for people and agents: specula projects, specula open --last, specula help.",
            "role": "small",
            "wrap": true
          }
        ]
