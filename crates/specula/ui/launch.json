{
  "format": "specula.ui.screen.v1",
  "name": "start",
  "input": "menu",
  "layer": 95,
  "modal": true,
  "focus": "st_new",
  "back": "start_back",
  "notes": "The engine's start screen (docs/design/LAUNCH.md): the projects worked on, the last one first; open one, make a new one, or open a folder as a project. Its own UI instance, drawn in the window only: never a UI-tools surface and never in a capture, so no agent reads the person's project list from it. Actions: start_open:N, start_forget:N, start_forget_yes, start_new, start_folder, start_ok, start_cancel, start_prev, start_next, start_close, start_back. State: version, listing, typing, forgetting, has_rows, first_page, list_title, row_N, row_N_name, row_N_path, row_N_when, row_N_warn, paged, has_prev, has_next, page_line, type_title, typed, type_note, type_ok, can_ok, forget_line, world_note, status_line, status_good.",
  "root": {
    "type": "box",
    "children": [
      {
        "type": "panel",
        "style": "sheet",
        "id": "st_sheet",
        "anchor": "top",
        "margin": [
          "5%",
          0,
          0,
          0
        ],
        "width": "94%",
        "max_width": "56em",
        "layout": "column",
        "align": "stretch",
        "gap": 10,
        "children": [
          {
            "type": "box",
            "layout": "row",
            "align": "center",
            "gap": 12,
            "children": [
              {
                "type": "label",
                "text": "Specula",
                "role": "title"
              },
              {
                "type": "label",
                "text": "{version}",
                "role": "small",
                "width": "fill"
              },
              {
                "type": "button",
                "id": "st_close",
                "text": "Close",
                "action": "start_close",
                "tooltip": "Use the engine with no project (Esc)."
              }
            ]
          },
          {
            "type": "panel",
            "style": "divider",
            "height": 1,
            "padding": 0
          },
          {
            "type": "box",
            "layout": "column",
            "align": "stretch",
            "gap": 8,
            "visible": "listing",
            "children": [
              {
                "type": "label",
                "text": "{list_title}",
                "role": "heading"
              },
              {
                "type": "label",
                "text": "No project has been worked on here yet. Make a new one, or open a folder as a project.",
                "role": "body",
                "visible": "!has_rows",
                "wrap": true
              },
              {
                "type": "box",
                "layout": "row",
                "align": "center",
                "gap": 10,
                "visible": "row_0",
                "children": [
                  {
                    "type": "button",
                    "id": "st_row_0",
                    "text": "{row_0_name}",
                    "action": "start_open:0",
                    "width": "17em",
                    "visible": [
                      "row_0",
                      "first_page"
                    ],
                    "tooltip": "Open this project.",
                    "style": "primary"
                  },
                  {
                    "type": "button",
                    "id": "st_row_0b",
                    "text": "{row_0_name}",
                    "action": "start_open:0",
                    "width": "17em",
                    "visible": [
                      "row_0",
                      "!first_page"
                    ],
                    "tooltip": "Open this project."
                  },
                  {
                    "type": "box",
                    "layout": "column",
                    "width": "fill",
                    "gap": 2,
                    "clip": true,
                    "children": [
                      {
                        "type": "label",
                        "text": "{row_0_path}",
                        "role": "small"
                      },
                      {
                        "type": "label",
                        "text": "{row_0_when}",
                        "role": "small",
                        "visible": "!row_0_warn"
                      },
                      {
                        "type": "label",
                        "text": "{row_0_when}",
                        "role": "warn",
                        "visible": "row_0_warn"
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "id": "st_forget_0",
                    "text": "Forget",
                    "action": "start_forget:0",
                    "tooltip": "Take it off this list. Its folder is not touched."
                  }
                ]
              },
              {
                "type": "box",
                "layout": "row",
                "align": "center",
                "gap": 10,
                "visible": "row_1",
