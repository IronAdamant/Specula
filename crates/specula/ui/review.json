{
  "format": "specula.ui.screen.v1",
  "name": "review",
  "input": "menu",
  "layer": 90,
  "modal": true,
  "focus": "rv_approve",
  "back": "review_close",
  "notes": "The engine's review screen (docs/design/REVIEW.md). Actions: review_approve, review_reject (then reject:<reason> or reject_cancel), review_batch, review_prev, review_next, review_close. State: position, has_item, has_prev, has_next, title, meta, checks_line, fail_1..fail_4, critiques_line, summary, promote_line, image_note, status_line, status_good, rejecting, batch_pending. The capture is drawn by the engine inside rv_image.",
  "root": {
    "type": "box",
    "children": [
      {
        "type": "panel",
        "style": "sheet",
        "id": "rv_sheet",
        "anchor": "top",
        "margin": ["6%", 0, 0, 0],
        "width": "94%",
        "max_width": "66em",
        "layout": "column",
        "align": "stretch",
        "gap": 10,
        "children": [
          {
            "type": "box", "layout": "row", "align": "center", "gap": 12,
            "children": [
              { "type": "label", "text": "Review queue", "role": "title" },
              { "type": "label", "text": "{position}", "role": "small", "width": "fill" },
              { "type": "button", "id": "rv_close", "text": "Close", "action": "review_close", "tooltip": "Back to the game (F9)." }
            ]
          },
          { "type": "panel", "style": "divider", "height": 1, "padding": 0 },
          {
            "type": "box", "layout": "row", "align": "start", "gap": 14, "visible": "has_item",
            "children": [
              {
                "type": "panel", "id": "rv_image", "style": "inset", "width": "fill:3", "height": "21em", "layout": "column", "align": "center", "justify": "center",
                "children": [
                  { "type": "label", "text": "{image_note}", "role": "small", "visible": "image_note", "text_align": "center" }
                ]
              },
              {
                "type": "box", "layout": "column", "width": "fill:2", "align": "stretch", "gap": 6, "clip": true,
                "children": [
                  { "type": "label", "id": "rv_title", "text": "{title}", "role": "heading", "wrap": true },
                  { "type": "label", "text": "{meta}", "role": "small", "wrap": true },
                  { "type": "label", "text": "{checks_line}", "role": "good", "visible": "!fail_1", "wrap": true },
                  { "type": "label", "text": "{checks_line}", "role": "warn", "visible": "fail_1", "wrap": true },
                  { "type": "label", "text": "{fail_1}", "role": "small", "visible": "fail_1", "wrap": true },
                  { "type": "label", "text": "{fail_2}", "role": "small", "visible": "fail_2", "wrap": true },
                  { "type": "label", "text": "{fail_3}", "role": "small", "visible": "fail_3", "wrap": true },
                  { "type": "label", "text": "{fail_4}", "role": "small", "visible": "fail_4", "wrap": true },
                  { "type": "label", "text": "{critiques_line}", "role": "warn", "visible": "critiques_line", "wrap": true },
                  { "type": "label", "text": "{summary}", "role": "body", "visible": "summary", "wrap": true },
                  { "type": "label", "text": "{promote_line}", "role": "small", "visible": "promote_line", "wrap": true }
                ]
              }
            ]
          },
          { "type": "label", "text": "Nothing is waiting for review.", "role": "body", "visible": "!has_item", "text_align": "center" },
          { "type": "label", "text": "{status_line}", "role": "good", "visible": ["status_line", "status_good"], "wrap": true },
          { "type": "label", "text": "{status_line}", "role": "warn", "visible": ["status_line", "!status_good"], "wrap": true },
          {
            "type": "box", "layout": "row", "justify": "center", "gap": 10, "visible": "!rejecting",
            "children": [
              { "type": "button", "id": "rv_prev", "text": "Prev", "action": "review_prev", "enabled": "has_prev" },
              { "type": "button", "id": "rv_approve", "style": "primary", "text": "Approve", "action": "review_approve", "enabled": "has_item" },
              { "type": "button", "id": "rv_reject", "text": "Reject", "action": "review_reject", "enabled": "has_item" },
              { "type": "button", "id": "rv_batch", "text": "Approve batch ({batch_pending})", "action": "review_batch", "visible": "batch_pending > 1" },
              { "type": "button", "id": "rv_next", "text": "Next", "action": "review_next", "enabled": "has_next" }
            ]
          },
          {
            "type": "box", "layout": "row", "justify": "center", "align": "center", "gap": 10, "visible": "rejecting",
            "children": [
              { "type": "label", "text": "Why?", "role": "heading" },
              { "type": "button", "id": "rv_r_style", "text": "Off-style", "action": "reject:off-style" },
              { "type": "button", "id": "rv_r_scale", "text": "Wrong scale", "action": "reject:wrong scale" },
              { "type": "button", "id": "rv_r_work", "text": "Needs work", "action": "reject:needs work" },
              { "type": "button", "id": "rv_r_broken", "text": "Broken", "action": "reject:broken" },
              { "type": "button", "id": "rv_r_cancel", "text": "Cancel", "action": "reject_cancel" }
            ]
          },
          {
            "type": "box", "layout": "row", "justify": "center", "gap": 18,
            "children": [
              { "type": "prompt", "action": "ui_accept", "text": "Select" },
              { "type": "prompt", "action": "review_prev", "text": "Prev" },
              { "type": "prompt", "action": "review_next", "text": "Next" },
              { "type": "prompt", "action": "ui_back", "text": "Close" }
            ]
          }
        ]
      }
    ]
  }
}
