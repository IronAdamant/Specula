{
  "format": "specula.ui.screen.v1",
  "name": "editor",
  "input": "menu",
  "layer": 80,
  "focus": "tb_move",
  "back": "editor_escape",
  "notes": "The engine's editor (docs/design/EDITOR.md): a toolbar, the outliner (left), the viewport (middle: picking and gizmos, drawn by the engine), the inspector (right) and the status bar, docked. Every edit is a protocol command as window:owner. Actions: mode_translate, mode_rotate, mode_scale, space_toggle, snap_toggle, editor_undo, editor_redo, editor_close, editor_frame, editor_delete; ol_prev, ol_next, ol_top, ol_search, ol_search_clear, ol_expand (rows' +/-), ol_select (rows); field:<key> (inspector fields; field:text types a text entity's words), step_down, step_up, toggle_visible, field_commit, field_cancel. State: see EditorUi::fill.",
  "root": {
    "type": "box", "width": "100%", "height": "100%", "layout": "column", "align": "stretch",
    "children": [
      {
        "type": "panel", "style": "bar", "id": "ed_toolbar", "layout": "row", "align": "center", "gap": 6,
        "children": [
          { "type": "label", "text": "Editor", "role": "heading" },
          { "type": "panel", "style": "divider", "width": 1, "height": 28, "padding": 0 },
          { "type": "button", "id": "tb_move", "text": "Move", "action": "mode_translate", "tooltip": "Translate gizmo (W).", "visible": "!mode_t" },
          { "type": "button", "id": "tb_move_on", "style": "primary", "text": "Move", "action": "mode_translate", "tooltip": "Translate gizmo (W).", "visible": "mode_t" },
          { "type": "button", "id": "tb_rotate", "text": "Rotate", "action": "mode_rotate", "tooltip": "Rotate gizmo (E).", "visible": "!mode_r" },
          { "type": "button", "id": "tb_rotate_on", "style": "primary", "text": "Rotate", "action": "mode_rotate", "tooltip": "Rotate gizmo (E).", "visible": "mode_r" },
          { "type": "button", "id": "tb_scale", "text": "Scale", "action": "mode_scale", "tooltip": "Scale gizmo (R).", "visible": "!mode_s" },
          { "type": "button", "id": "tb_scale_on", "style": "primary", "text": "Scale", "action": "mode_scale", "tooltip": "Scale gizmo (R).", "visible": "mode_s" },
          { "type": "panel", "style": "divider", "width": 1, "height": 28, "padding": 0 },
          { "type": "button", "id": "tb_space", "text": "{space_label}", "action": "space_toggle", "tooltip": "World or local axes (L)." },
          { "type": "button", "id": "tb_snap", "text": "Snap off", "action": "snap_toggle", "tooltip": "Snap to the grid, angle and scale steps (G; hold Ctrl to invert while dragging).", "visible": "!snap_on" },
          { "type": "button", "id": "tb_snap_on", "style": "primary", "text": "{snap_label}", "action": "snap_toggle", "tooltip": "Snap to the grid, angle and scale steps (G; hold Ctrl to invert while dragging).", "visible": "snap_on" },
          { "type": "panel", "style": "divider", "width": 1, "height": 28, "padding": 0 },
          { "type": "button", "id": "tb_undo", "text": "Undo", "action": "editor_undo", "enabled": "can_undo", "tooltip": "Undo your last edit (Ctrl+Z): world_undo." },
          { "type": "button", "id": "tb_redo", "text": "Redo", "action": "editor_redo", "enabled": "can_redo", "tooltip": "Redo (Ctrl+Y): undoes the undo." },
          { "type": "button", "id": "tb_frame", "text": "Frame", "action": "editor_frame", "enabled": "has_sel", "tooltip": "Frame the selection (F)." },
          { "type": "button", "id": "tb_delete", "text": "Delete", "action": "editor_delete", "enabled": "has_sel", "tooltip": "Delete the selection (Del): world_batch." },
          { "type": "panel", "style": "divider", "width": 1, "height": 28, "padding": 0 },
          { "type": "button", "id": "tb_claims", "text": "Claim map", "action": "claim_map", "visible": "!claim_map", "tooltip": "Draw every agent's claims in the viewport with the holder's name." },
          { "type": "button", "id": "tb_claims_on", "style": "primary", "text": "Claim map", "action": "claim_map", "visible": "claim_map", "tooltip": "Draw every agent's claims in the viewport with the holder's name." },
          { "type": "button", "id": "tb_ask", "text": "Ask...", "action": "ask_open", "enabled": "has_sel", "tooltip": "Ask the agents about what you highlighted (only your keyboard types there)." },
          { "type": "box", "width": "fill" },
          { "type": "label", "text": "{who}", "role": "small" },
          { "type": "button", "id": "tb_close", "text": "Close", "action": "editor_close", "tooltip": "Back to the game (F7)." }
        ]
      },
      {
        "type": "box", "layout": "row", "align": "stretch", "height": "fill",
        "children": [
          {
            "type": "panel", "style": "dock", "id": "ed_outliner", "width": "21em", "layout": "column", "align": "stretch", "gap": 4, "clip": true,
            "children": [
              {
                "type": "box", "layout": "row", "align": "center", "gap": 6,
                "children": [
                  { "type": "label", "text": "Outliner", "role": "heading", "width": "fill" },
                  { "type": "label", "text": "{ol_count}", "role": "small" }
                ]
              },
              {
                "type": "box", "layout": "row", "align": "center", "gap": 4,
                "children": [
                  { "type": "button", "id": "ol_search", "style": "field", "text": "{ol_search_text}", "action": "ol_search", "width": "fill", "tooltip": "Type to search by name; #tag filters by tag. Enter keeps it, Esc clears." },
                  { "type": "button", "id": "ol_search_clear", "style": "small", "text": "x", "action": "ol_search_clear", "visible": "ol_searching", "tooltip": "Clear the search." }
                ]
              },
              {
                "type": "list", "id": "ol_list", "height": "fill", "gap": 1,
                "repeat": {
                  "source": "rows", "max": 18,
                  "template": {
                    "type": "box", "layout": "row", "align": "center", "gap": 2,
                    "children": [
                      { "type": "button", "id": "ol_x", "style": "small", "text": "{item.arrow}", "action": "ol_expand", "visible": "item.has_children" },
                      { "type": "box", "width": 28, "visible": "!item.has_children" },
                      { "type": "button", "id": "ol_row", "style": "row", "action": "ol_select", "width": "fill", "justify": "start", "visible": "!item.selected", "tooltip": "{item.tip}", "children": [ { "type": "label", "text": "{item.label}", "role": "body", "width": "fill" }, { "type": "label", "text": "{item.badge}", "role": "warn", "visible": "item.badge" } ] },
                      { "type": "button", "id": "ol_row_on", "style": "row_on", "action": "ol_select", "width": "fill", "justify": "start", "visible": "item.selected", "tooltip": "{item.tip}", "children": [ { "type": "label", "text": "{item.label}", "role": "body", "width": "fill" }, { "type": "label", "text": "{item.badge}", "role": "warn", "visible": "item.badge" } ] }
                    ]
                  }
                }
              },
              { "type": "label", "text": "{ol_note}", "role": "small", "visible": "ol_note", "wrap": true },
              {
                "type": "box", "layout": "row", "align": "center", "gap": 4,
                "children": [
                  { "type": "button", "id": "ol_top", "style": "small", "text": "Top", "action": "ol_top", "enabled": "ol_has_prev" },
                  { "type": "button", "id": "ol_prev", "style": "small", "text": "Prev", "action": "ol_prev", "enabled": "ol_has_prev" },
                  { "type": "label", "text": "{ol_page}", "role": "small", "width": "fill", "text_align": "center" },
                  { "type": "button", "id": "ol_next", "style": "small", "text": "Next", "action": "ol_next", "enabled": "ol_has_next" }
                ]
              }
            ]
          },
          { "type": "box", "id": "ed_viewport", "width": "fill" },
          {
            "type": "panel", "style": "dock", "id": "ed_inspector", "width": "24em", "layout": "column", "align": "stretch", "gap": 5, "clip": true,
            "children": [
              {
                "type": "box", "layout": "row", "align": "center", "gap": 4,
                "children": [
                  { "type": "button", "id": "tab_inspector", "style": "small", "text": "Inspector", "action": "tab_inspector", "visible": "!tab_inspector", "tooltip": "The selected entity: its name, place and components." },
                  { "type": "button", "id": "tab_inspector_on", "style": "primary", "text": "Inspector", "action": "tab_inspector", "visible": "tab_inspector" },
                  { "type": "button", "id": "tab_swarm", "style": "small", "text": "Swarm", "action": "tab_swarm", "visible": "!tab_swarm", "tooltip": "What the agents are doing: journal, claims, board, review queue, cost." },
                  { "type": "button", "id": "tab_swarm_on", "style": "primary", "text": "Swarm", "action": "tab_swarm", "visible": "tab_swarm" }
                ]
              },
              {
                "type": "box", "id": "sw_panel", "layout": "column", "align": "stretch", "gap": 4, "height": "fill", "visible": "tab_swarm",
                "children": [
                  {
                    "type": "box", "layout": "row", "align": "center", "gap": 2,
                    "children": [
                      { "type": "button", "id": "sw_journal", "style": "small", "text": "Journal", "action": "sw_journal", "visible": "!sw_is_journal", "tooltip": "Which agent built this: journal entries, newest first." },
                      { "type": "button", "id": "sw_journal_on", "style": "primary", "text": "Journal", "action": "sw_journal", "visible": "sw_is_journal" },
                      { "type": "button", "id": "sw_claims", "style": "small", "text": "Claims", "action": "sw_claims", "visible": "!sw_is_claims", "tooltip": "Claims and leases, with their holders." },
                      { "type": "button", "id": "sw_claims_on", "style": "primary", "text": "Claims", "action": "sw_claims", "visible": "sw_is_claims" },
                      { "type": "button", "id": "sw_board", "style": "small", "text": "Board", "action": "sw_board", "visible": "!sw_is_board", "tooltip": "Tasks, intents and notes." },
                      { "type": "button", "id": "sw_board_on", "style": "primary", "text": "Board", "action": "sw_board", "visible": "sw_is_board" },
                      { "type": "button", "id": "sw_review", "style": "small", "text": "Review", "action": "sw_review", "visible": "!sw_is_review", "tooltip": "Work waiting for your decision." },
                      { "type": "button", "id": "sw_review_on", "style": "primary", "text": "Review", "action": "sw_review", "visible": "sw_is_review" },
                      { "type": "button", "id": "sw_cost", "style": "small", "text": "Cost", "action": "sw_cost", "visible": "!sw_is_cost", "tooltip": "Calls, commits and refusals per agent; progress per task." },
                      { "type": "button", "id": "sw_cost_on", "style": "primary", "text": "Cost", "action": "sw_cost", "visible": "sw_is_cost" }
                    ]
                  },
                  { "type": "label", "text": "{sw_title}", "role": "heading" },
                  {
                    "type": "box", "layout": "row", "align": "center", "gap": 2, "visible": "sw_is_journal",
                    "children": [
                      { "type": "button", "id": "sw_agent", "style": "small", "text": "{sw_agent}", "action": "sw_agent", "tooltip": "Only this agent's entries (click for the next agent seen)." },
                      { "type": "button", "id": "sw_game", "style": "small", "text": "{sw_game}", "action": "sw_game", "tooltip": "The hosted game's own entries (every tick: many)." }
                    ]
                  },
                  { "type": "button", "id": "sw_place", "style": "small", "text": "{sw_place}", "action": "sw_place", "visible": "sw_is_journal", "tooltip": "Only entries touching the selected entity (by identity), then under its path." },
                  { "type": "button", "id": "sw_show", "style": "small", "text": "{sw_board}", "action": "sw_show", "visible": "sw_is_board", "tooltip": "Tasks, intents or notes." },
                  {
                    "type": "list", "id": "sw_list", "height": "fill", "gap": 6,
                    "repeat": {
                      "source": "sw_rows", "max": 10,
                      "template": {
                        "type": "box", "layout": "column", "align": "stretch",
                        "children": [
                          { "type": "button", "id": "sw_row", "style": "row", "action": "sw_select", "layout": "column", "align": "start", "visible": "!item.selected", "children": [ { "type": "label", "text": "{item.label}", "role": "small", "width": "fill", "wrap": true }, { "type": "label", "text": "{item.badge}", "role": "warn", "visible": "item.badge" } ] },
                          { "type": "button", "id": "sw_row_on", "style": "row_on", "action": "sw_select", "layout": "column", "align": "start", "visible": "item.selected", "children": [ { "type": "label", "text": "{item.label}", "role": "small", "width": "fill", "wrap": true }, { "type": "label", "text": "{item.badge}", "role": "warn", "visible": "item.badge" } ] }
                        ]
                      }
                    }
                  },
                  { "type": "label", "text": "{sw_note}", "role": "small", "visible": "sw_note", "wrap": true },
                  { "type": "label", "text": "{sw_detail}", "role": "body", "visible": "sw_detail", "wrap": true },
                  { "type": "button", "id": "sw_open_review", "style": "primary", "text": "Open in the review screen", "action": "sw_open_review", "visible": "sw_can_open", "tooltip": "Approve or reject it there (F9 closes it)." },
                  {
                    "type": "box", "layout": "row", "align": "center", "gap": 4,
                    "children": [
                      { "type": "button", "id": "sw_newest", "style": "small", "text": "Newest", "action": "sw_newest", "enabled": "sw_has_prev" },
                      { "type": "button", "id": "sw_newer", "style": "small", "text": "Newer", "action": "sw_newer", "enabled": "sw_has_prev" },
                      { "type": "label", "text": "{sw_page}", "role": "small", "width": "fill", "text_align": "center" },
                      { "type": "button", "id": "sw_older", "style": "small", "text": "Older", "action": "sw_older", "enabled": "sw_has_next" }
                    ]
                  }
                ]
              },
              {
                "type": "box", "id": "in_panel", "layout": "column", "align": "stretch", "gap": 5, "visible": "tab_inspector",
                "children": [
              { "type": "label", "text": "Click an entity, or pick one in the outliner.", "role": "small", "visible": "!has_sel", "wrap": true },
              {
                "type": "box", "layout": "column", "align": "stretch", "gap": 5, "visible": "has_sel",
                "children": [
                  { "type": "button", "id": "in_name", "style": "field", "text": "{in_name}", "action": "field:name", "tooltip": "Rename (type, then Enter)." },
                  { "type": "button", "id": "in_text", "style": "field", "text": "{in_text}", "action": "field:text", "visible": "in_has_text", "tooltip": "Type this text's words (Backspace edits from the end, then Enter)." },
                  { "type": "label", "text": "{in_path}", "role": "small", "wrap": true },
                  { "type": "label", "text": "{in_meta}", "role": "small", "wrap": true },
                  { "type": "label", "text": "{in_claim}", "role": "warn", "visible": "in_claimed", "wrap": true },
                  { "type": "label", "text": "{in_claim}", "role": "good", "visible": "!in_claimed", "wrap": true },
                  { "type": "label", "text": "{in_more}", "role": "small", "visible": "in_more", "wrap": true },
                  { "type": "panel", "style": "divider", "height": 1, "padding": 0 },
                  {
                    "type": "box", "layout": "row", "align": "center", "gap": 3,
                    "children": [
                      { "type": "label", "text": "Position", "role": "small", "width": "5.4em" },
                      { "type": "button", "id": "f_px", "style": "field", "text": "{f_px}", "action": "field:px", "width": "fill" },
                      { "type": "button", "id": "f_py", "style": "field", "text": "{f_py}", "action": "field:py", "width": "fill" },
                      { "type": "button", "id": "f_pz", "style": "field", "text": "{f_pz}", "action": "field:pz", "width": "fill" }
                    ]
                  },
                  {
                    "type": "box", "layout": "row", "align": "center", "gap": 3,
                    "children": [
                      { "type": "label", "text": "Rotation", "role": "small", "width": "5.4em" },
                      { "type": "button", "id": "f_rx", "style": "field", "text": "{f_rx}", "action": "field:rx", "width": "fill" },
                      { "type": "button", "id": "f_ry", "style": "field", "text": "{f_ry}", "action": "field:ry", "width": "fill" },
                      { "type": "button", "id": "f_rz", "style": "field", "text": "{f_rz}", "action": "field:rz", "width": "fill" }
                    ]
                  },
                  {
                    "type": "box", "layout": "row", "align": "center", "gap": 3,
                    "children": [
                      { "type": "label", "text": "Scale", "role": "small", "width": "5.4em" },
                      { "type": "button", "id": "f_sx", "style": "field", "text": "{f_sx}", "action": "field:sx", "width": "fill" },
                      { "type": "button", "id": "f_sy", "style": "field", "text": "{f_sy}", "action": "field:sy", "width": "fill" },
                      { "type": "button", "id": "f_sz", "style": "field", "text": "{f_sz}", "action": "field:sz", "width": "fill" }
                    ]
                  },
                  {
                    "type": "box", "layout": "row", "align": "center", "gap": 3,
                    "children": [
                      { "type": "label", "text": "Colour", "role": "small", "width": "5.4em" },
                      { "type": "button", "id": "f_cr", "style": "field", "text": "{f_cr}", "action": "field:cr", "width": "fill" },
                      { "type": "button", "id": "f_cg", "style": "field", "text": "{f_cg}", "action": "field:cg", "width": "fill" },
                      { "type": "button", "id": "f_cb", "style": "field", "text": "{f_cb}", "action": "field:cb", "width": "fill" }
                    ]
                  },
                  {
                    "type": "box", "layout": "row", "align": "center", "gap": 4,
                    "children": [
                      { "type": "label", "text": "{field_label}", "role": "small", "width": "fill" },
                      { "type": "button", "id": "f_down", "style": "small", "text": "-", "action": "step_down", "enabled": "has_field", "tooltip": "Step the active field down by the snap step." },
                      { "type": "button", "id": "f_up", "style": "small", "text": "+", "action": "step_up", "enabled": "has_field", "tooltip": "Step the active field up by the snap step." },
                      { "type": "button", "id": "f_ok", "style": "small", "text": "Set", "action": "field_commit", "visible": "typing", "tooltip": "Commit the typed value (Enter)." }
                    ]
                  },
                  { "type": "button", "id": "f_visible", "text": "{visible_label}", "action": "toggle_visible", "tooltip": "Show or hide it (world_set visible)." },
                  { "type": "label", "text": "{in_components}", "role": "small", "visible": "in_components", "wrap": true },
                  { "type": "button", "id": "in_ask", "style": "primary", "text": "Ask the agents...", "action": "ask_open", "tooltip": "Ask the swarm to change what you highlighted: your words go to the task board when you send them." }
                ]
              }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "panel", "style": "bar", "id": "ed_status", "layout": "row", "align": "center", "gap": 10,
        "children": [
          { "type": "label", "text": "{status_line}", "role": "good", "visible": "status_good", "width": "fill", "wrap": true },
          { "type": "label", "text": "{status_line}", "role": "warn", "visible": "!status_good", "width": "fill", "wrap": true },
          { "type": "label", "text": "{sel_line}", "role": "small" },
          { "type": "prompt", "action": "editor_toggle", "text": "Close" }
        ]
      }
    ]
  }
}
