{
  "sound": 1,
  "name": "determinism_probe",
  "notes": "Exercises every source, filter and fx type; its hash is pinned in synth tests.",
  "seed": 1234,
  "duration": 0.75,
  "channels": 2,
  "loudness": -20,
  "loop": { "crossfade": 0.1 },
  "vary": { "pitch": [-2, 2], "gain_db": [-3, 0] },
  "layers": [
    { "name": "fm_bell", "pan": -0.4,
      "source": { "wave": "sine", "freq": 330, "partials": [[1, 1, 0.5], [2.76, 0.4, 0.2]],
                  "fm": { "ratio": 1.4, "index": { "points": [[0, 4], [0.5, 0.2]] } } },
      "env": { "attack": 0.002, "decay": 0.4, "sustain": 0.2, "release": 0.1 },
      "vibrato": { "rate": 5, "depth": 0.2, "delay": 0.1 } },
    { "name": "square_arp", "at": 0.05, "length": 0.4, "pan": 0.5, "gain_db": -6,
      "source": { "wave": "square", "freq": 220, "duty": { "points": [[0, 0.2], [0.4, 0.5]] }, "unison": { "voices": 3, "cents": 12 } },
      "arp": { "steps": [0, 3, 7], "rate": 15 },
      "filters": [ { "type": "lowpass", "cutoff": { "points": [[0, 6000], [0.4, 400]], "curve": "exp" }, "q": 4 } ],
      "fx": [ { "type": "bitcrush", "bits": 6, "rate": 11025 }, { "type": "distort", "drive": 3 } ] },
    { "name": "saw_tri", "at": 0.1, "gain_db": -10,
      "source": { "wave": "saw", "freq": { "rand": [90, 110] } },
      "filters": [ { "type": "bandpass", "cutoff": 900, "q": 2 }, { "type": "hp1", "cutoff": 120 } ],
      "fx": [ { "type": "tremolo", "rate": 7, "depth": 0.6 }, { "type": "delay", "time": 0.11, "feedback": 0.4, "mix": 0.3 } ] },
    { "name": "tri", "gain_db": -12, "source": { "wave": "triangle", "freq": 660 },
      "env": { "points": [[0, 0], [0.05, 1], [0.3, 0]] },
      "filters": [ { "type": "notch", "cutoff": 660, "q": 1 }, { "type": "lp1", "cutoff": 3000 } ] },
    { "name": "crackle", "gain_db": -8, "pan": { "rand": [-1, 1] },
      "source": { "wave": "noise", "color": "pink" },
      "env": { "attack": 0.0005, "decay": 0.01, "sustain": 0, "release": 0.002 },
      "filters": [ { "type": "highpass", "cutoff": { "rand": [1500, 4000] }, "q": 1.5 } ],
      "repeat": { "count": 12, "interval": 0.05, "jitter": 0.02, "gain_db_step": -0.5, "pitch_jitter": 3 } },
    { "name": "rumble", "gain_db": -14, "source": { "wave": "noise", "color": "brown", "freq": 3000 },
      "fx": [ { "type": "reverb", "room": 0.5, "damp": 0.5, "mix": 0.4 } ] },
    { "name": "white", "gain_db": -24, "source": { "wave": "noise" } }
  ],
  "fx": [ { "type": "reverb", "room": 0.6, "damp": 0.4, "mix": 0.2, "width": 0.8 }, { "type": "delay", "time": 0.2, "feedback": 0.2, "mix": 0.1 } ]
}
