{
  "format": "specula.input.v1",
  "actions": [
    {
      "name": "move",
      "kind": "axis2",
      "group": "walk",
      "description": "Walk: +x = right (+X), +y = forward (-Z). Agents: logic_input {\"move\": [x, y]}.",
      "bindings": [
        "Pad.LeftStick",
        { "composite": { "up": "Key.W", "down": "Key.S", "left": "Key.A", "right": "Key.D" } },
        { "composite": { "up": "Key.Up", "down": "Key.Down", "left": "Key.Left", "right": "Key.Right" } }
      ]
    },
    {
      "name": "jump",
      "kind": "button",
      "group": "walk",
      "description": "Jump (only while standing on something).",
      "bindings": ["Key.Space", "Pad.South"]
    }
  ]
}
