{
  "lex": 1,
  "name": "sepulcra_slice",
  "tick_hz": 30,
  "notes": "A slice of Sepulcra in Lex: ground waves from the middle gorge up the central lane to the south gate, the warding stone, brazier cairn and rune pillar in three tiers, grave-dust income, costs, drops, selling, calling waves early, tombstones, win and lose. games/sepulcra/tests/lex_parity.rs runs it next to the hand-written sim and compares every tick. Projectile speeds are written as the hand-written sim's whole millimetres per tick (20 m/s there moves 666 mm a tick, so 19.98 m/s here).",
  "items": {
    "start_dust": { "kind": "param", "type": "int", "value": 150, "min": 0, "max": 2000, "doc": "grave-dust at the start" },
    "start_tombstones": { "kind": "param", "type": "int", "value": 10, "min": 1, "max": 50, "doc": "lives: a leak costs the enemy's tombstones" },
    "shambler_hp": { "kind": "param", "type": "points", "value": 55, "min": 1, "max": 1000, "doc": "shambler health before the wave's scale" },
    "runner_hp": { "kind": "param", "type": "points", "value": 26, "min": 1, "max": 1000, "doc": "skeleton runner health before the wave's scale" },
    "sell_refund": { "kind": "param", "type": "ratio", "value": 0.7, "min": 0, "max": 1, "doc": "share of everything spent on a stone that selling returns" },
    "early_call_per_s": { "kind": "param", "type": "ratio", "value": 0.5, "min": 0, "max": 10, "doc": "dust per second left on the timer when a wave is called early" },

    "dust": { "kind": "resource", "start": "$start_dust", "min": 0 },
    "tombstones": { "kind": "resource", "start": "$start_tombstones", "min": 0 },

    "lane_mid": {
      "kind": "path",
      "notes": "The middle gorge (top:9,19) straight up the central lane to the south gate and the first graveyard cell (top:9,11). Cells are 2 m; x = 2 col - 19, z = 2 row - 19.",
      "points": [[-1, 0, 19], [-1, 0, 17], [-1, 0, 15], [-1, 0, 13], [-1, 0, 11], [-1, 0, 9], [-1, 0, 7], [-1, 0, 5], [-1, 0, 3]]
    },
    "build_spots": {
      "kind": "sites",
      "notes": "The fragment cells beside the central lane, named as in the hand-written sim.",
      "points": {
        "top:8,12": [-3, 0, 5], "top:10,12": [1, 0, 5],
        "top:8,14": [-3, 0, 9], "top:10,14": [1, 0, 9],
        "top:8,15": [-3, 0, 11], "top:10,15": [1, 0, 11],
        "top:8,16": [-3, 0, 13], "top:10,16": [1, 0, 13],
        "top:8,18": [-3, 0, 17], "top:10,18": [1, 0, 17]
      }
    },

    "slow": {
      "kind": "effect",
      "notes": "Rune pillars' slow: one per enemy; a stronger or equal slow replaces it and the later expiry wins.",
      "duration": "1.5s",
      "magnitude": "ratio",
      "stacking": "strongest",
      "modifiers": [{ "attribute": "speed_scale", "op": "mul", "value": "100% - magnitude" }]
    },

    "enemy": {
      "kind": "archetype",
      "abstract": true,
      "tags": ["enemy", "ground"],
      "attributes": {
        "hp": { "base": 1, "unit": "points" },
        "speed": { "base": 1, "unit": "speed" },
        "speed_scale": "100%",
        "tombstones": 1,
        "drop_min": 1,
        "drop_max": 1
      },
      "behaviours": [
        { "type": "health", "attribute": "hp", "on_death": [{ "add": "dust", "amount": "rand(drops, self.drop_min, self.drop_max)" }] },
        { "type": "follow_path", "path": "@spawn", "speed": "self.speed", "scale": "self.speed_scale",
          "on_arrive": [{ "add": "tombstones", "amount": "-self.tombstones" }, { "despawn": "self" }] }
      ]
    },
    "shambler": {
      "kind": "archetype",
      "extends": "enemy",
      "attributes": { "hp": "$shambler_hp", "speed": "0.8m/s", "drop_min": 3, "drop_max": 5 }
    },
    "runner": {
      "kind": "archetype",
      "extends": "enemy",
      "attributes": { "hp": "$runner_hp", "speed": "2.2m/s", "drop_min": 2, "drop_max": 4 }
    },

    "bolt": {
      "kind": "archetype",
      "tags": ["projectile"],
      "attributes": { "speed": "20m/s" },
      "behaviours": [{ "type": "projectile", "speed": "self.speed", "homing": true }]
    },
    "lob": {
      "kind": "archetype",
      "tags": ["projectile"],
      "attributes": { "speed": "10m/s", "splash": "1m" },
      "behaviours": [{ "type": "projectile", "speed": "self.speed", "homing": false, "splash": "self.splash" }]
    },

    "stone": {
      "kind": "archetype",
      "abstract": true,
      "tags": ["stone"],
      "attributes": { "cost": 0, "invested": 0 }
    },
    "warding_1": {
      "kind": "archetype",
      "extends": "stone",
      "notes": "Homing bolts at ground enemies.",
      "attributes": { "cost": 50 },
      "next": "warding_2",
      "behaviours": [{
        "type": "attack", "targets": ["enemy", "ground"], "range": "7m", "cooldown": "0.8s", "policy": "first",
        "projectile": { "archetype": "bolt", "with": { "speed": "19.98m/s" } }, "muzzle": [0, 1.5, 0],
        "payload": [{ "damage": "10pt" }]
      }]
    },
    "warding_2": {
      "kind": "archetype",
      "extends": "warding_1",
      "tags": ["upgrade"],
      "attributes": { "cost": 60 },
      "next": "warding_3",
      "behaviours": [{
        "type": "attack", "targets": ["enemy", "ground"], "range": "7.5m", "cooldown": "0.7s", "policy": "first",
        "projectile": { "archetype": "bolt", "with": { "speed": "21.99m/s" } }, "muzzle": [0, 1.5, 0],
        "payload": [{ "damage": "18pt" }]
      }]
    },
    "warding_3": {
      "kind": "archetype",
      "extends": "warding_2",
      "attributes": { "cost": 90 },
      "next": null,
      "behaviours": [{
        "type": "attack", "targets": ["enemy", "ground"], "range": "8m", "cooldown": "0.6s", "policy": "first",
        "projectile": { "archetype": "bolt", "with": { "speed": "24m/s" } }, "muzzle": [0, 1.5, 0],
        "payload": [{ "damage": "30pt" }]
      }]
    },
    "rune_pillar_1": {
      "kind": "archetype",
      "extends": "stone",
      "notes": "Pulses every enemy in range: a slow, then a little damage.",
      "attributes": { "cost": 60 },
      "next": "rune_pillar_2",
      "behaviours": [{
        "type": "attack", "targets": ["enemy", "ground"], "range": "5m", "cooldown": "1s", "delivery": "pulse",
        "payload": [{ "effect": "slow", "magnitude": "35%", "duration": "1.5s" }, { "damage": "2pt" }]
      }]
    },
    "rune_pillar_2": {
      "kind": "archetype",
      "extends": "rune_pillar_1",
      "tags": ["upgrade"],
      "attributes": { "cost": 60 },
      "next": "rune_pillar_3",
      "behaviours": [{
        "type": "attack", "targets": ["enemy", "ground"], "range": "5.5m", "cooldown": "1s", "delivery": "pulse",
        "payload": [{ "effect": "slow", "magnitude": "45%", "duration": "1.5s" }, { "damage": "4pt" }]
      }]
    },
    "rune_pillar_3": {
      "kind": "archetype",
      "extends": "rune_pillar_2",
      "attributes": { "cost": 90 },
      "next": null,
      "behaviours": [{
        "type": "attack", "targets": ["enemy", "ground"], "range": "6m", "cooldown": "1s", "delivery": "pulse",
        "payload": [{ "effect": "slow", "magnitude": "55%", "duration": "1.5s" }, { "damage": "6pt" }]
      }]
    },
    "brazier_1": {
      "kind": "archetype",
      "extends": "stone",
      "notes": "Lobs fire where the target stood; it splashes on landing.",
      "attributes": { "cost": 80 },
      "next": "brazier_2",
      "behaviours": [{
        "type": "attack", "targets": ["enemy", "ground"], "range": "6m", "cooldown": "1.6s", "policy": "first",
        "projectile": { "archetype": "lob", "with": { "speed": "9.99m/s", "splash": "1.8m" } }, "muzzle": [0, 1.5, 0],
        "payload": [{ "damage": "16pt" }]
      }]
    },
    "brazier_2": {
      "kind": "archetype",
      "extends": "brazier_1",
      "tags": ["upgrade"],
      "attributes": { "cost": 80 },
      "next": "brazier_3",
      "behaviours": [{
        "type": "attack", "targets": ["enemy", "ground"], "range": "6.5m", "cooldown": "1.5s", "policy": "first",
        "projectile": { "archetype": "lob", "with": { "speed": "10.98m/s", "splash": "2m" } }, "muzzle": [0, 1.5, 0],
        "payload": [{ "damage": "28pt" }]
      }]
    },
    "brazier_3": {
      "kind": "archetype",
      "extends": "brazier_2",
      "attributes": { "cost": 110 },
      "next": null,
      "behaviours": [{
        "type": "attack", "targets": ["enemy", "ground"], "range": "7m", "cooldown": "1.4s", "policy": "first",
        "projectile": { "archetype": "lob", "with": { "speed": "12m/s", "splash": "2.3m" } }, "muzzle": [0, 1.5, 0],
        "payload": [{ "damage": "45pt" }]
      }]
    },

    "place": {
      "kind": "command",
      "notes": "Carve a tier I stone on a free build spot.",
      "args": { "site": "site", "stone": { "type": "archetype", "tags": ["stone", "!upgrade"] } },
      "require": [
        { "when": "!occupied(arg.site, stone)", "code": "occupied", "message": "a stone already stands there" },
        { "when": "res.dust >= arg.stone.cost", "code": "not_enough_dust", "message": "not enough grave-dust" }
      ],
      "do": [
        { "add": "dust", "amount": "-arg.stone.cost" },
        { "spawn": "arg.stone", "at": "arg.site", "with": { "invested": "arg.stone.cost" } }
      ]
    },
    "upgrade": {
      "kind": "command",
      "notes": "Carve the next tier of runes into a stone (by its site or id).",
      "args": { "stone": { "type": "entity", "tags": ["stone"] } },
      "require": [
        { "when": "exists(arg.stone.next)", "code": "max_tier", "message": "the stone is at its last tier" },
        { "when": "res.dust >= arg.stone.next.cost", "code": "not_enough_dust", "message": "not enough grave-dust" }
      ],
      "do": [
        { "add": "dust", "amount": "-arg.stone.next.cost" },
        { "change": "arg.stone.invested", "by": "arg.stone.next.cost" },
        { "become": "arg.stone.next", "who": "arg.stone", "keep": ["invested"] }
      ]
    },
    "sell": {
      "kind": "command",
      "notes": "Refunds a share of everything spent on the stone.",
      "args": { "stone": { "type": "entity", "tags": ["stone"] } },
      "do": [
        { "add": "dust", "amount": "arg.stone.invested * $sell_refund" },
        { "despawn": "arg.stone" }
      ]
    },
    "call_wave": {
      "kind": "command",
      "notes": "Start the next wave now, for dust per second left on its timer.",
      "require": [{ "when": "waves.remaining > 0", "code": "no_more_waves", "message": "every wave has started" }],
      "do": [
        { "add": "dust", "amount": "waves.ticks_left * $early_call_per_s / 1s" },
        { "next_wave": true }
      ]
    },

    "waves": {
      "kind": "waves",
      "start": "30s",
      "rng": "waves",
      "waves": [
        { "duration": "55s", "on_start": [{ "add": "dust", "amount": 0 }],
          "groups": [{ "archetype": "shambler", "count": 6, "at": ["lane_mid"], "start": "0s", "every": "3s" }] },
        { "duration": "60s", "on_start": [{ "add": "dust", "amount": 40 }],
          "groups": [
            { "archetype": "shambler", "count": 8, "at": ["lane_mid"], "start": "0s", "every": "3s" },
            { "archetype": "runner", "count": 6, "at": ["lane_mid"], "start": "10s", "every": "2s" }
          ] },
        { "duration": "65s", "on_start": [{ "add": "dust", "amount": 50 }], "scale": { "hp": 1.1 },
          "groups": [
            { "archetype": "shambler", "count": 10, "at": ["lane_mid"], "start": "0s", "every": "2.5s" },
            { "archetype": "runner", "count": 8, "at": ["lane_mid"], "start": "5s", "every": "2s" }
          ] },
        { "duration": "65s", "on_start": [{ "add": "dust", "amount": 60 }], "scale": { "hp": 1.2 },
          "groups": [
            { "archetype": "shambler", "count": 8, "at": ["lane_mid"], "start": "0s", "every": "3s" },
            { "archetype": "runner", "count": 10, "at": ["lane_mid"], "start": "15s", "every": "1.5s" }
          ] }
      ]
    },

    "lose": { "kind": "outcome", "result": "lost", "when": "res.tombstones <= 0", "priority": 1 },
    "win": { "kind": "outcome", "result": "won", "when": "waves.all_cleared" }
  }
}
