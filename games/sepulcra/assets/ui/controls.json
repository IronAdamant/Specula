{
  "format": "specula.ui.screen.v1",
  "name": "controls",
  "input": "menu",
  "layer": 30,
  "modal": true,
  "back": "close_controls",
  "notes": "The controls list (read only for now: rebinding is an open owner question). State: bindings (rows: label = action description, keys = current glyphs for the active device, e.g. \"LMB / A\").",
  "root": {
    "type": "box",
    "children": [
      {
        "type": "panel",
        "style": "menu",
        "anchor": "center",
        "width": "30em",
        "max_width": "96%",
        "max_height": "92%",
        "layout": "column",
        "align": "stretch",
        "gap": 10,
        "children": [
          {
            "type": "label",
            "text": "Controls",
            "role": "title",
            "text_align": "center"
          },
          {
            "type": "list",
            "id": "binding_list",
            "height": "18em",
            "gap": 4,
            "padding": [
              0,
              12,
              0,
              0
            ],
            "repeat": {
              "source": "bindings",
              "max": 24,
              "template": {
                "type": "box",
                "layout": "row",
                "justify": "space_between",
                "align": "center",
                "padding": [
                  4,
                  6
                ],
                "children": [
                  {
                    "type": "label",
                    "text": "{item.label}",
                    "role": "body"
                  },
                  {
                    "type": "panel",
                    "style": "keycap",
                    "layout": "row",
                    "align": "center",
                    "children": [
                      {
                        "type": "label",
                        "text": "{item.keys}",
                        "role": "keycap"
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "type": "box",
            "layout": "row",
            "gap": 10,
            "children": [
              {
                "type": "button",
                "id": "controls_back",
                "style": "primary",
                "text": "Back",
                "action": "close_controls",
                "width": "fill"
              }
            ]
          }
        ]
      }
    ]
  },
  "focus": "controls_back"
}
