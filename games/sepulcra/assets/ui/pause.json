{
  "format": "specula.ui.screen.v1",
  "name": "pause",
  "input": "menu",
  "layer": 20,
  "modal": true,
  "focus": "resume",
  "back": "resume",
  "opened_by": ["pause", "cancel", "open_menu"],
  "notes": "On short screens (ui.short) the wave line and divider make room. Actions: resume, speed (cycles x1, x2, x4: the HUD button's gamepad path), open_saves (the Save / Load screen), open_settings, open_controls, restart (asks first). State: wave, waves, speed.",
  "root": {
    "type": "box",
    "children": [
      {
        "type": "panel",
        "style": "menu",
        "id": "pause_panel",
        "anchor": "center",
        "width": "20em",
        "layout": "column",
        "align": "stretch",
        "gap": 10,
        "children": [
          { "type": "label", "text": "@pause.paused", "role": "title", "text_align": "center" },
          { "type": "label", "text": "@pause.wave_waves", "role": "subtitle", "text_align": "center", "visible": "!ui.short" },
          { "type": "panel", "style": "divider", "height": 1, "padding": 0, "margin": [6, 0, 6, 0], "visible": "!ui.short" },
          { "type": "button", "id": "resume", "style": "primary", "text": "@pause.resume", "action": "resume" },
          { "type": "button", "id": "pause_speed", "text": "@pause.game_speed_x", "action": "speed", "tooltip": "@pause.x1_x2_x4_hud" },
          { "type": "button", "id": "saves", "text": "@pause.save_load", "action": "open_saves", "tooltip": "@pause.save_this_run_slot" },
          { "type": "button", "id": "settings", "text": "@pause.settings", "action": "open_settings" },
          { "type": "button", "id": "controls", "text": "@pause.controls", "action": "open_controls" },
          { "type": "button", "id": "restart", "text": "@pause.restart_run", "action": "restart", "tooltip": "@pause.start_this_seed_again" },
          {
            "type": "box", "layout": "row", "justify": "center", "gap": 18, "margin": [6, 0, 0, 0],
            "children": [
              { "type": "prompt", "action": "ui_accept", "text": "@pause.select" },
              { "type": "prompt", "action": "ui_back", "text": "@pause.resume" }
            ]
          }
        ]
      }
    ]
  }
}
