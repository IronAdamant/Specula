{
  "format": "specula.ui.screen.v1",
  "name": "pause",
  "input": "menu",
  "layer": 20,
  "modal": true,
  "focus": "resume",
  "back": "resume",
  "notes": "Actions: resume, open_settings, open_controls, restart (asks first). State: wave, waves.",
  "root": {
    "type": "box",
    "children": [
      {
        "type": "panel",
        "style": "menu",
        "id": "pause_panel",
        "anchor": "center",
        "width": "20em",
        "layout": "column",
        "align": "stretch",
        "gap": 10,
        "children": [
          { "type": "label", "text": "Paused", "role": "title", "text_align": "center" },
          { "type": "label", "text": "Wave {wave} of {waves}", "role": "subtitle", "text_align": "center" },
          { "type": "panel", "style": "divider", "height": 1, "padding": 0, "margin": [6, 0, 6, 0] },
          { "type": "button", "id": "resume", "style": "primary", "text": "Resume", "action": "resume" },
          { "type": "button", "id": "settings", "text": "Settings", "action": "open_settings" },
          { "type": "button", "id": "controls", "text": "Controls", "action": "open_controls" },
          { "type": "button", "id": "restart", "text": "Restart run", "action": "restart", "tooltip": "Start this seed again. Your run is lost." },
          {
            "type": "box", "layout": "row", "justify": "center", "gap": 18, "margin": [6, 0, 0, 0],
            "children": [
              { "type": "prompt", "action": "ui_accept", "text": "Select" },
              { "type": "prompt", "action": "ui_back", "text": "Resume" }
            ]
          }
        ]
      }
    ]
  }
}
