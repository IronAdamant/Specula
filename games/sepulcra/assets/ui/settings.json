{
  "format": "specula.ui.screen.v1",
  "name": "settings",
  "input": "menu",
  "layer": 30,
  "modal": true,
  "focus": "ui_scale",
  "back": "close_settings",
  "opened_by": ["open_settings"],
  "notes": "Each button cycles a setting; Accessibility opens the accessibility settings (access). Settings are saved per user (with a window). State: ui_scale (ratio), ui_scale_text (the size and what it gives on this display, e.g. \"115% (x1.55)\", or Auto), reduced_motion_text, glyph_style (Auto / Xbox / PlayStation / Steam Deck), volume (ratio), autosave_text (On / Off), language (the language's own name). Words come from the string table (assets/strings/<locale>.json).",
  "root": {
    "type": "box",
    "children": [
      {
        "type": "panel",
        "style": "menu",
        "anchor": "center",
        "width": "24em",
        "max_width": "96%",
        "max_height": "94%",
        "layout": "column",
        "align": "stretch",
        "gap": 6,
        "children": [
          { "type": "label", "text": "@settings.settings", "role": "title", "text_align": "center", "visible": "!ui.short" },
          {
            "type": "list", "id": "settings_list", "height": "fill", "gap": 10, "padding": [0, 12, 0, 0],
            "notes": "Scrolls when the text or interface size leaves too little room (focus scrolls it).",
            "children": [
          { "type": "button", "id": "ui_scale", "text": "@settings.interface_size_ui_scale", "action": "cycle_ui_scale" },
          { "type": "button", "id": "accessibility", "text": "@settings.accessibility", "action": "open_access", "tooltip": "@settings.accessibility_tip" },
          { "type": "button", "id": "volume", "text": "@settings.volume", "action": "cycle_volume" },
          { "type": "button", "id": "glyphs", "text": "@settings.button_prompts_glyph_style", "action": "cycle_glyphs" },
          { "type": "button", "id": "motion", "text": "@settings.reduced_motion_text", "action": "toggle_motion", "tooltip": "@settings.stops_ui_animation_camera" },
          { "type": "button", "id": "autosave", "text": "@settings.autosave_text", "action": "toggle_autosave", "tooltip": "@settings.save_two_autosave_slots" },
          { "type": "button", "id": "language", "text": "@settings.language", "action": "cycle_language", "tooltip": "@settings.language_tip" }
            ]
          },
          { "type": "button", "id": "settings_back", "style": "primary", "text": "@settings.back", "action": "close_settings" }
        ]
      }
    ]
  }
}
