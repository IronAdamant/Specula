{
  "format": "specula.ui.screen.v1",
  "name": "hud",
  "input": "hud",
  "layer": 0,
  "notes": "State the game supplies each frame: wave, waves, next_wave_s (absent while a wave runs), early_bonus, dust, tombstones, tombstones_max, paused, speed, running, selected (warding|pillar|brazier|obelisk|wall, absent when nothing is selected), selected_name, selected_role, selected_detail, selected_cost, affordable, sel_<icon> / cost_<icon> / can_<icon> for the build bar (icons warding, pillar, brazier, obelisk, wall), hover (text about the cell under the cursor), inspect (the selected stone or wall's name, absent when none), inspect_icon, inspect_detail, upgrade_detail, upgrade_cost (absent at tier III), can_upgrade, refund, inspect_stone, inspect_wall, threats (rows: x, y in physical px from the camera projection, behind, label). Actions: select:<icon>, upgrade, sell, unwall, deselect, call_wave, pause, resume, speed, open_build_menu. Layout adapts with ui.narrow (phones in portrait).",
  "root": {
    "type": "box",
    "children": [
      { "type": "threats", "source": "threats", "margin": [64, 10, 84, 10], "notes": "Arrows stay between the top bar and the build bar." },
      {
        "type": "panel",
        "id": "top_bar",
        "anchor": "top",
        "margin": [8, 8, 0, 8],
        "layout": "row",
        "align": "center",
        "gap": "$l",
        "children": [
          {
            "type": "box", "id": "wave_group", "layout": "row", "align": "center", "gap": 7,
            "tooltip": "Waves survived and the next wave's timer.",
            "children": [
              { "type": "icon", "shape": "wave", "color": "rune_pale" },
              { "type": "label", "id": "wave", "text": "Wave {wave}/{waves}", "role": "value" },
              { "type": "label", "id": "next_wave", "text": "next {next_wave_s:time}", "role": "small", "visible": "next_wave_s" }
            ]
          },
          { "type": "panel", "style": "divider", "width": 1, "height": "1.5em", "padding": 0 },
          {
            "type": "box", "id": "dust_group", "layout": "row", "align": "center", "gap": 7,
            "children": [
              { "type": "icon", "shape": "dust", "color": "bone" },
              { "type": "label", "id": "dust", "text": "{dust}", "role": "value" },
              { "type": "label", "text": "dust", "role": "small", "visible": "!ui.narrow" }
            ]
          },
          { "type": "panel", "style": "divider", "width": 1, "height": "1.5em", "padding": 0 },
          {
            "type": "box", "id": "tomb_group", "layout": "row", "align": "center", "gap": 7,
            "children": [
              { "type": "icon", "shape": "tombstone", "color": "bone" },
              { "type": "label", "id": "tombstones", "text": "{tombstones}/{tombstones_max}", "role": "value" },
              { "type": "bar", "id": "tomb_bar", "value": "tombstones", "max": "tombstones_max", "width": "4.5em", "visible": "!ui.narrow" }
            ]
          },
          { "type": "label", "id": "paused", "text": "PAUSED", "role": "heading", "color": "fire", "visible": "paused" },
          { "type": "label", "id": "speed", "text": "x{speed}", "role": "heading", "color": "rune", "visible": "speed > 1" }
        ]
      },
      {
        "type": "box",
        "id": "corner",
        "anchor": "top_right",
        "margin": 8,
        "layout": "row",
        "gap": 6,
        "visible": "!ui.narrow",
        "notes": "Touch-sized (44 logical px at least). On phones the same buttons sit under the top bar (corner_narrow).",
        "children": [
          { "type": "button", "id": "speed_button", "style": "compact", "min_width": 52, "min_height": 44, "text": "x{speed}", "action": "speed", "tooltip": "Game speed: x1, x2, x4.", "children": [ { "type": "prompt", "action": "speed" } ] },
          { "type": "button", "id": "pause_button", "style": "compact", "min_width": 52, "min_height": 44, "icon": "pause", "action": "pause", "visible": "!paused", "tooltip": "Active pause: building still works.", "children": [ { "type": "prompt", "action": "pause" } ] },
          { "type": "button", "id": "resume_button", "style": "compact", "min_width": 52, "min_height": 44, "icon": "play", "action": "resume", "visible": "paused", "tooltip": "Resume." }
        ]
      },
      {
        "type": "box",
        "id": "corner_narrow",
        "anchor": "top_right",
        "margin": [72, 8, 0, 0],
        "layout": "row",
        "gap": 6,
        "visible": "ui.narrow",
        "children": [
          { "type": "button", "id": "speed_button_narrow", "style": "compact", "min_width": 52, "min_height": 44, "text": "x{speed}", "action": "speed" },
          { "type": "button", "id": "pause_button_narrow", "style": "compact", "min_width": 52, "min_height": 44, "icon": "pause", "action": "pause", "visible": "!paused" },
          { "type": "button", "id": "resume_button_narrow", "style": "compact", "min_width": 52, "min_height": 44, "icon": "play", "action": "resume", "visible": "paused" }
        ]
      },
      { "type": "toasts", "anchor": "top", "margin": [72, 0, 0, 0], "width": "24em", "max": 4 },
      {
        "type": "panel",
        "id": "selected",
        "anchor": "bottom_left",
        "margin": 12,
        "width": "19em",
        "layout": "column",
        "align": "stretch",
        "gap": 8,
        "visible": "selected && !ui.narrow",
        "children": [
          {
            "type": "box", "layout": "row", "align": "center", "gap": 12,
            "children": [
              {
                "type": "panel", "style": "inset", "padding": 5,
                "children": [
                  { "type": "icon", "shape": "warding", "size": "2.3em", "color": "#aab4c0", "visible": "selected == warding" },
                  { "type": "icon", "shape": "pillar", "size": "2.3em", "color": "#aab4c0", "visible": "selected == pillar" },
                  { "type": "icon", "shape": "brazier", "size": "2.3em", "color": "#aab4c0", "visible": "selected == brazier" },
                  { "type": "icon", "shape": "obelisk", "size": "2.3em", "color": "#aab4c0", "visible": "selected == obelisk" },
                  { "type": "icon", "shape": "wall", "size": "2.3em", "color": "#aab4c0", "visible": "selected == wall" }
                ]
              },
              {
                "type": "box", "layout": "column", "gap": 1, "width": "fill",
                "children": [
                  { "type": "label", "id": "selected_name", "text": "{selected_name}", "role": "heading" },
                  { "type": "label", "id": "selected_role", "text": "{selected_role}", "role": "small" }
                ]
              }
            ]
          },
          { "type": "label", "id": "selected_detail", "text": "{selected_detail}", "role": "small", "wrap": true },
          {
            "type": "box", "layout": "row", "align": "center", "gap": 7,
            "children": [
              { "type": "icon", "shape": "dust", "color": "bone", "size": "1.1em" },
              { "type": "label", "id": "selected_cost", "text": "{selected_cost}", "role": "value" },
              { "type": "label", "text": "Not enough dust", "role": "small", "color": "fire", "visible": "!affordable" }
            ]
          },
          {
            "type": "box", "layout": "row", "align": "center", "gap": 16,
            "children": [
              { "type": "prompt", "action": "place", "text": "Carve" },
              { "type": "prompt", "action": "build_menu", "text": "Stones" },
              { "type": "prompt", "action": "upgrade", "text": "Upgrade" }
            ]
          }
        ]
      },
      {
        "type": "button",
        "id": "call_wave",
        "anchor": "bottom_right",
        "margin": 12,
        "text": "Call wave +{early_bonus}",
        "action": "call_wave",
        "shortcut": "call_wave",
        "visible": "next_wave_s && !ui.narrow",
        "tooltip": "Start the next wave now for bonus dust.",
        "children": [ { "type": "prompt", "action": "call_wave" } ]
      },
      {"type": "panel", "id": "build_bar", "anchor": "bottom", "margin": [0, 0, 10, 0], "padding": 6, "layout": "row", "align": "center", "gap": 6, "visible": "running && !ui.narrow", "children": [{"type": "button", "id": "build_warding_on", "icon": "warding", "action": "select:warding", "visible": "sel_warding", "tooltip": "Warding stone: single target", "children": [{"type": "label", "text": "{cost_warding}", "role": "value", "visible": "can_warding"}, {"type": "label", "text": "{cost_warding}", "role": "value", "color": "fire", "visible": "!can_warding"}, {"type": "prompt", "action": "select_1"}], "style": "primary"}, {"type": "button", "id": "build_warding", "icon": "warding", "action": "select:warding", "visible": "!sel_warding", "tooltip": "Warding stone: single target", "children": [{"type": "label", "text": "{cost_warding}", "role": "value", "visible": "can_warding"}, {"type": "label", "text": "{cost_warding}", "role": "value", "color": "fire", "visible": "!can_warding"}, {"type": "prompt", "action": "select_1"}]}, {"type": "button", "id": "build_pillar_on", "icon": "pillar", "action": "select:pillar", "visible": "sel_pillar", "tooltip": "Rune pillar: slows an area", "children": [{"type": "label", "text": "{cost_pillar}", "role": "value", "visible": "can_pillar"}, {"type": "label", "text": "{cost_pillar}", "role": "value", "color": "fire", "visible": "!can_pillar"}, {"type": "prompt", "action": "select_2"}], "style": "primary"}, {"type": "button", "id": "build_pillar", "icon": "pillar", "action": "select:pillar", "visible": "!sel_pillar", "tooltip": "Rune pillar: slows an area", "children": [{"type": "label", "text": "{cost_pillar}", "role": "value", "visible": "can_pillar"}, {"type": "label", "text": "{cost_pillar}", "role": "value", "color": "fire", "visible": "!can_pillar"}, {"type": "prompt", "action": "select_2"}]}, {"type": "button", "id": "build_brazier_on", "icon": "brazier", "action": "select:brazier", "visible": "sel_brazier", "tooltip": "Brazier cairn: splash fire", "children": [{"type": "label", "text": "{cost_brazier}", "role": "value", "visible": "can_brazier"}, {"type": "label", "text": "{cost_brazier}", "role": "value", "color": "fire", "visible": "!can_brazier"}, {"type": "prompt", "action": "select_3"}], "style": "primary"}, {"type": "button", "id": "build_brazier", "icon": "brazier", "action": "select:brazier", "visible": "!sel_brazier", "tooltip": "Brazier cairn: splash fire", "children": [{"type": "label", "text": "{cost_brazier}", "role": "value", "visible": "can_brazier"}, {"type": "label", "text": "{cost_brazier}", "role": "value", "color": "fire", "visible": "!can_brazier"}, {"type": "prompt", "action": "select_3"}]}, {"type": "button", "id": "build_obelisk_on", "icon": "obelisk", "action": "select:obelisk", "visible": "sel_obelisk", "tooltip": "Sky obelisk: anti-air", "children": [{"type": "label", "text": "{cost_obelisk}", "role": "value", "visible": "can_obelisk"}, {"type": "label", "text": "{cost_obelisk}", "role": "value", "color": "fire", "visible": "!can_obelisk"}, {"type": "prompt", "action": "select_4"}], "style": "primary"}, {"type": "button", "id": "build_obelisk", "icon": "obelisk", "action": "select:obelisk", "visible": "!sel_obelisk", "tooltip": "Sky obelisk: anti-air", "children": [{"type": "label", "text": "{cost_obelisk}", "role": "value", "visible": "can_obelisk"}, {"type": "label", "text": "{cost_obelisk}", "role": "value", "color": "fire", "visible": "!can_obelisk"}, {"type": "prompt", "action": "select_4"}]}, {"type": "button", "id": "build_wall_on", "icon": "wall", "action": "select:wall", "visible": "sel_wall", "tooltip": "Stone wall: reroutes the dead", "children": [{"type": "label", "text": "{cost_wall}", "role": "value", "visible": "can_wall"}, {"type": "label", "text": "{cost_wall}", "role": "value", "color": "fire", "visible": "!can_wall"}, {"type": "prompt", "action": "select_wall"}], "style": "primary"}, {"type": "button", "id": "build_wall", "icon": "wall", "action": "select:wall", "visible": "!sel_wall", "tooltip": "Stone wall: reroutes the dead", "children": [{"type": "label", "text": "{cost_wall}", "role": "value", "visible": "can_wall"}, {"type": "label", "text": "{cost_wall}", "role": "value", "color": "fire", "visible": "!can_wall"}, {"type": "prompt", "action": "select_wall"}]}], "notes": "Selection is always allowed (the panel shows the stone, its range ring shows on hover); a cost in fire colour means you can't afford it yet."},
      {"type": "panel", "id": "inspect", "anchor": "right", "margin": [0, 12, 0, 0], "width": "19em", "max_width": "96%", "layout": "column", "align": "stretch", "gap": 8, "visible": "inspect", "children": [{"type": "box", "layout": "row", "align": "center", "gap": 10, "children": [{"type": "panel", "style": "inset", "padding": 5, "children": [{"type": "icon", "shape": "warding", "size": "2em", "color": "#aab4c0", "visible": "inspect_icon == warding"}, {"type": "icon", "shape": "pillar", "size": "2em", "color": "#aab4c0", "visible": "inspect_icon == pillar"}, {"type": "icon", "shape": "brazier", "size": "2em", "color": "#aab4c0", "visible": "inspect_icon == brazier"}, {"type": "icon", "shape": "obelisk", "size": "2em", "color": "#aab4c0", "visible": "inspect_icon == obelisk"}, {"type": "icon", "shape": "wall", "size": "2em", "color": "#aab4c0", "visible": "inspect_icon == wall"}]}, {"type": "label", "id": "inspect_name", "text": "{inspect}", "role": "heading", "width": "fill", "wrap": true}, {"type": "button", "id": "deselect", "style": "compact", "min_width": 44, "min_height": 44, "icon": "cross", "action": "deselect", "tooltip": "Close (deselect)."}]}, {"type": "label", "id": "inspect_detail", "text": "{inspect_detail}", "role": "small", "wrap": true}, {"type": "label", "id": "upgrade_detail", "text": "{upgrade_detail}", "role": "small", "wrap": true, "color": "rune_pale", "visible": "inspect_stone"}, {"type": "box", "layout": "row", "gap": 8, "children": [{"type": "button", "id": "upgrade", "style": "primary", "text": "Carve +{upgrade_cost}", "action": "upgrade", "visible": "upgrade_cost", "enabled": "can_upgrade", "width": "fill", "tooltip": "Carve the next tier.", "children": [{"type": "prompt", "action": "upgrade"}]}, {"type": "button", "id": "sell", "text": "Sell +{refund}", "action": "sell", "visible": "inspect_stone", "width": "fill", "tooltip": "70% of what it cost.", "children": [{"type": "prompt", "action": "sell"}]}, {"type": "button", "id": "unwall", "text": "Remove +{refund}", "action": "unwall", "visible": "inspect_wall", "width": "fill", "children": [{"type": "prompt", "action": "unwall"}]}]}]},
      {
        "type": "panel",
        "id": "hover",
        "anchor": "bottom",
        "margin": [0, 0, 84, 0],
        "padding": [5, 12],
        "visible": "hover && !ui.narrow",
        "children": [ { "type": "label", "id": "hover_text", "text": "{hover}", "role": "small" } ]
      },
      {
        "type": "panel",
        "id": "selected_narrow",
        "anchor": "bottom",
        "margin": 8,
        "width": "fill",
        "layout": "column",
        "align": "stretch",
        "gap": 8,
        "visible": "ui.narrow",
        "children": [
          {
            "type": "box", "layout": "row", "align": "center", "gap": 10, "visible": "selected",
            "children": [
              { "type": "icon", "shape": "warding", "size": "2em", "color": "#aab4c0", "visible": "selected == warding" },
              { "type": "icon", "shape": "pillar", "size": "2em", "color": "#aab4c0", "visible": "selected == pillar" },
              { "type": "icon", "shape": "brazier", "size": "2em", "color": "#aab4c0", "visible": "selected == brazier" },
              { "type": "icon", "shape": "obelisk", "size": "2em", "color": "#aab4c0", "visible": "selected == obelisk" },
              { "type": "icon", "shape": "wall", "size": "2em", "color": "#aab4c0", "visible": "selected == wall" },
              {
                "type": "box", "layout": "column", "width": "fill",
                "children": [
                  { "type": "label", "text": "{selected_name}", "role": "heading" },
                  { "type": "label", "text": "{selected_role}", "role": "small" }
                ]
              },
              { "type": "icon", "shape": "dust", "color": "bone", "size": "1.1em" },
              { "type": "label", "text": "{selected_cost}", "role": "value" }
            ]
          },
          { "type": "label", "text": "Not enough dust", "role": "small", "color": "fire", "visible": "selected && !affordable" },
          {
            "type": "box", "layout": "row", "gap": 8,
            "children": [
              { "type": "button", "id": "stones_narrow", "text": "Stones", "action": "open_build_menu", "shortcut": "build_menu", "width": "fill" },
              { "type": "button", "id": "call_wave_narrow", "text": "Call wave +{early_bonus}", "action": "call_wave", "shortcut": "call_wave", "width": "fill", "visible": "next_wave_s" }
            ]
          }
        ]
      }
    ]
  }
}
