{
  "format": "specula.ui.screen.v1",
  "name": "defeat",
  "input": "menu",
  "layer": 25,
  "modal": true,
  "focus": "retry",
  "notes": "Shown when the last tombstone falls. State: wave, waves, kills, run_time_s.",
  "root": {
    "type": "box",
    "children": [
      {
        "type": "panel",
        "style": "menu",
        "anchor": "center",
        "width": "22em",
        "max_width": "96%",
        "layout": "column",
        "align": "stretch",
        "gap": 10,
        "children": [
          { "type": "box", "layout": "row", "justify": "center", "children": [ { "type": "icon", "shape": "tombstone", "size": "3em", "color": "bone" } ] },
          { "type": "label", "text": "The dead rise", "role": "title", "text_align": "center", "wrap": true },
          { "type": "label", "text": "Fell on wave {wave} of {waves}", "role": "subtitle", "text_align": "center" },
          { "type": "panel", "style": "divider", "height": 1, "padding": 0, "margin": [6, 0, 6, 0] },
          {
            "type": "box", "layout": "grid", "columns": 2, "gap": 6,
            "children": [
              { "type": "label", "text": "Undead laid to rest", "role": "body" },
              { "type": "label", "text": "{kills}", "role": "heading", "text_align": "right", "width": "fill" },
              { "type": "label", "text": "Time", "role": "body" },
              { "type": "label", "text": "{run_time_s:time}", "role": "heading", "text_align": "right", "width": "fill" }
            ]
          },
          { "type": "button", "id": "retry", "style": "primary", "text": "Try again", "action": "new_run" },
          { "type": "button", "id": "defeat_title", "text": "Title screen", "action": "quit_to_title" }
        ]
      }
    ]
  }
}
