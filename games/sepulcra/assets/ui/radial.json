{
  "format": "specula.ui.screen.v1",
  "name": "radial",
  "input": "menu",
  "layer": 10,
  "back": "close_build_menu",
  "opened_by": ["build_menu", "open_build_menu"],
  "notes": "The radial build menu. Gamepad: point with the left stick (or step with the d-pad), accept carves, back closes. Mouse / touch: point or tap a wedge. Actions: build:<stone>. State: dust (items you can't afford are disabled but still show their cost).",
  "root": {
    "type": "box",
    "children": [
      {
        "type": "radial",
        "id": "build",
        "anchor": "center",
        "radius": 146,
        "inner_radius": 62,
        "items": [
          { "id": "warding", "label": "@radial.warding", "icon": "warding", "action": "build:warding", "enabled": "dust >= 50", "detail": "@radial.warding_detail" },
          { "id": "pillar", "label": "@radial.pillar", "icon": "pillar", "action": "build:pillar", "enabled": "dust >= 60", "detail": "@radial.pillar_detail" },
          { "id": "brazier", "label": "@radial.brazier", "icon": "brazier", "action": "build:brazier", "enabled": "dust >= 80", "detail": "@radial.brazier_detail" },
          { "id": "obelisk", "label": "@radial.obelisk", "icon": "obelisk", "action": "build:obelisk", "enabled": "dust >= 70", "detail": "@radial.obelisk_detail" },
          { "id": "wall", "label": "@radial.wall", "icon": "wall", "action": "build:wall", "enabled": "dust >= 15", "detail": "@radial.wall_detail" }
        ]
      },
      {
        "type": "panel",
        "id": "radial_hints",
        "visible": "!ui.touch && ui.width >= 1200 && ui.height >= 600 || !ui.touch && ui.height >= 700",
        "anchor": "center",
        "offset": [0, 196],
        "layout": "row",
        "gap": 18,
        "padding": [6, 14],
        "children": [
          { "type": "prompt", "action": "ui_accept", "text": "@radial.carve" },
          { "type": "prompt", "action": "ui_back", "text": "@radial.cancel" }
        ]
      },
      {
        "type": "panel",
        "id": "radial_hints_side",
        "notes": "Short screens: under the ring is the bottom panel, so the hints sit at the left. That is under 700 logical px high on compact screens (the Deck at UI scale 1.15 and up: the taller narrow bottom panel), and under 600 on wide ones (an ultrawide at UI scale 1.5: the build bar).",
        "visible": "!ui.touch && ui.height < 600 || !ui.touch && ui.width < 1200 && ui.height < 700",
        "anchor": "left",
        "margin": [0, 0, 0, 12],
        "layout": "column",
        "gap": 10,
        "padding": [8, 14],
        "children": [
          { "type": "prompt", "action": "ui_accept", "text": "@radial.carve" },
          { "type": "prompt", "action": "ui_back", "text": "@radial.cancel" }
        ]
      }
    ]
  }
}
