{
  "recipe": 1,
  "name": "grass_tuft",
  "category": "foliage",
  "description": "A tuft of grass: three crossed upright cards, one quad each (alpha-cutout blades from tex_grass_blades, lit from either side) that sway in the world's wind. Meant to be scattered (grass_patch) or instanced; `height` in metres.",
  "seed": 5,
  "params": { "height": { "default": 0.42, "min": 0.15, "max": 1.2 } },
  "budget": { "max_triangles": 6 },
  "collider": "none",
  "smooth_angle": 0,
  "textures": { "blades": "tex_grass_blades" },
  "wind": { "amount": 0.07 },
  "let": { "w": "height * 1.5" },
  "parts": [
    { "name": "card_a", "material": "grass", "texture": "blades", "uv_scale": "height * 1.08",
      "shape": { "op": "plane", "size": ["w", "height"] },
      "ops": [ { "op": "rotate", "deg": [90, 0, 0] }, { "op": "move", "by": [0, "height * 0.5", 0] } ] },
    { "name": "card_b", "material": "grass", "texture": "blades", "uv_scale": "height * 1.08",
      "shape": { "op": "plane", "size": ["w", "height"] },
      "ops": [ { "op": "rotate", "deg": [90, 0, 0] }, { "op": "move", "by": [0, "height * 0.5", 0] }, { "op": "rotate", "deg": [0, 60, 0] } ] },
    { "name": "card_c", "material": "grass", "texture": "blades", "uv_scale": "height * 1.08",
      "shape": { "op": "plane", "size": ["w", "height"] },
      "ops": [ { "op": "rotate", "deg": [90, 0, 0] }, { "op": "move", "by": [0, "height * 0.5", 0] }, { "op": "rotate", "deg": [0, 120, 0] } ] }
  ]
}
