{
  "recipe": 1,
  "name": "brazier_cairn",
  "category": "stone",
  "description": "Splash-fire stone. A cairn of three stacked rough stones carrying an iron bowl of fire: the bowl top is its silhouette (STYLE.md). Tier I: a rune on the base stone; II: runes front and back plus a carved capstone collar under the bowl; III: all faces and a rune ring floating above the flames.",
  "seed": 303,
  "params": { "tier": { "default": 1, "min": 1, "max": 3, "integer": true } },
  "let": {
    "b_h": "0.5",
    "m_h": "0.42",
    "t_h": "0.3",
    "top": "b_h + m_h + t_h",
    "collar": "tier >= 2 ? 0.14 : 0",
    "bowl_y": "top + collar",
    "face": "0.558"
  },
  "budget": { "max_triangles": "tier >= 3 ? 3000 : 1500" },
  "lods": [0.5, 0.25],
  "collider": "convex_hull",
  "smooth_angle": 28,
  "parts": [
    { "name": "base_stone", "material": "carved_stone",
      "shape": { "op": "box", "size": [1.25, "b_h", 1.1], "bevel": 0.07 },
      "ops": [ { "op": "displace", "amount": 0.02, "scale": 0.4, "axes": [0.4, 1, 0.2] },
               { "op": "gradient", "from": "carved_shadow", "to": "carved_stone", "range": [0, 1] },
               { "op": "bevel_tint", "color": "carved_highlight", "amount": 0.7 } ] },
    { "name": "mid_stone", "material": "carved_stone",
      "shape": { "op": "box", "size": [1.0, "m_h", 0.9], "bevel": 0.07 },
      "ops": [ { "op": "displace", "amount": 0.04, "scale": 0.35 },
               { "op": "rotate", "deg": [0, 22, 2] },
               { "op": "move", "by": [0.03, "b_h - 0.01", -0.02] },
               { "op": "bevel_tint", "color": "carved_highlight", "amount": 0.7 },
               { "op": "noise_tint", "amount": 0.08, "scale": 0.3 } ] },
    { "name": "top_stone", "material": "carved_stone",
      "shape": { "op": "box", "size": [0.82, "t_h", 0.76], "bevel": 0.06 },
      "ops": [ { "op": "displace", "amount": 0.035, "scale": 0.3 },
               { "op": "rotate", "deg": [-2, -14, 0] },
               { "op": "move", "by": [-0.02, "b_h + m_h - 0.02", 0.01] },
               { "op": "bevel_tint", "color": "carved_highlight", "amount": 0.7 },
               { "op": "noise_tint", "amount": 0.08, "scale": 0.3 } ] },
    { "name": "capstone", "material": "carved_stone", "when": "tier >= 2",
      "shape": { "op": "cylinder", "radius": 0.74, "height": 0.16, "sides": 10, "bevel": 0.04 },
      "ops": [ { "op": "move", "by": [0, "top - 0.02", 0] },
               { "op": "color", "color": "carved_highlight" },
               { "op": "bevel_tint", "color": "rune_pale", "amount": 0.25 } ] },
    { "name": "capstone_runes", "material": "rune_glow", "when": "tier >= 2", "lod_detail": 0.4,
      "note": "a glowing rune band round the capstone: tier II reads from the default camera",
      "shape": { "op": "torus", "radius": 0.75, "tube": 0.03, "segments": 16, "sides": 3 },
      "ops": [ { "op": "move", "by": [0, "top + 0.03", 0] } ] },
    { "name": "stem", "material": "iron",
      "shape": { "op": "cylinder", "radius": 0.14, "height": 0.12, "sides": 8, "bevel": 0.02 },
      "ops": [ { "op": "move", "by": [0, "bowl_y - 0.02", 0] } ] },
    { "name": "bowl", "material": "iron",
      "shape": { "op": "lathe", "segments": 14,
                 "profile": [[0, 0], [0.18, 0], [0.22, 0.04], [0.5, 0.25], [0.62, 0.36], [0.64, 0.41], [0.58, 0.42], [0.5, 0.33], [0.2, 0.14], [0, 0.14]] },
      "ops": [ { "op": "move", "by": [0, "bowl_y + 0.08", 0] },
               { "op": "gradient", "from": "iron_dark", "to": "iron", "range": [0, 1] } ] },
    { "name": "fire", "include": "brazier_fire", "params": { "size": 0.95 },
      "ops": [ { "op": "move", "by": [0, "bowl_y + 0.2", 0] } ] },
    { "name": "rune_front", "include": "rune_column", "params": { "count": 1, "first": 0, "size": 0.3 },
      "ops": [ { "op": "move", "by": [0, 0.44, "face"] } ] },
    { "name": "rune_back", "include": "rune_column", "when": "tier >= 2", "params": { "count": 1, "first": 2, "size": 0.3 },
      "ops": [ { "op": "rotate", "deg": [0, 180, 0] }, { "op": "move", "by": [0, 0.44, "-face"] } ] },
    { "name": "rune_right", "include": "rune_column", "when": "tier >= 3", "params": { "count": 1, "first": 1, "size": 0.3 },
      "ops": [ { "op": "rotate", "deg": [0, 90, 0] }, { "op": "move", "by": [0.633, 0.44, 0] } ] },
    { "name": "rune_left", "include": "rune_column", "when": "tier >= 3", "params": { "count": 1, "first": 3, "size": 0.3 },
      "ops": [ { "op": "rotate", "deg": [0, -90, 0] }, { "op": "move", "by": [-0.633, 0.44, 0] } ] },
    { "name": "halo", "material": "rune_glow", "when": "tier >= 3",
      "shape": { "op": "torus", "radius": 0.78, "tube": 0.045, "segments": 30, "sides": 6 },
      "ops": [ { "op": "rotate", "deg": [6, 0, -8] }, { "op": "move", "by": [0, "bowl_y + 1.25", 0] } ] }
  ],
  "finish": [ { "op": "ground_shade", "amount": 0.35, "height": 0.45 } ]
}
