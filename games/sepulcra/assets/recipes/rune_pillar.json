{
  "recipe": 1,
  "name": "rune_pillar",
  "category": "stone",
  "description": "Area-slow stone. Square pillar with a flat top and a carved stone ring around its upper third (STYLE.md). Tier I: runes on the front; II: front and back plus a wide capstone slab; III: all faces and a floating rune ring above the top.",
  "seed": 202,
  "params": { "tier": { "default": 1, "min": 1, "max": 3, "integer": true } },
  "let": {
    "plinth": "0.16",
    "h": "tier >= 3 ? 2.6 : 2.45",
    "w": "0.9",
    "face": "w / 2 + 0.008",
    "ring_y": "h - 0.62",
    "runes": "tier >= 2 ? 3 : 2"
  },
  "budget": { "max_triangles": "tier >= 3 ? 3000 : 1500" },
  "lods": [0.5, 0.25],
  "collider": "convex_hull",
  "smooth_angle": 25,
  "parts": [
    { "name": "plinth", "material": "carved_stone", "color": "carved_shadow",
      "shape": { "op": "box", "size": [1.25, "plinth", 1.25], "bevel": 0.05 },
      "ops": [ { "op": "displace", "amount": 0.02, "scale": 0.5, "axes": [1, 0.3, 1] },
               { "op": "bevel_tint", "color": "carved_stone", "amount": 0.7 } ] },
    { "name": "shaft", "material": "carved_stone",
      "shape": { "op": "loft", "outline": { "rect": ["w", "w"], "bevel": 0.055 },
                 "stations": [[0.92, 0], [1.0, 0.055], [1.0, "h - plinth - 0.055"], [0.9, "h - plinth"]] },
      "ops": [ { "op": "move", "by": [0, "plinth", 0] },
               { "op": "gradient", "from": "carved_shadow", "to": "carved_stone", "range": [0, 0.45] },
               { "op": "bevel_tint", "color": "carved_highlight", "amount": 0.75 },
               { "op": "noise_tint", "amount": 0.07, "scale": 0.35 } ] },
    { "name": "stone_ring", "material": "carved_stone", "lod_detail": 0.3,
      "shape": { "op": "torus", "radius": 0.7, "tube": 0.1, "segments": 16, "sides": 6 },
      "ops": [ { "op": "move", "by": [0, "ring_y - 0.1", 0] },
               { "op": "displace", "amount": 0.015, "scale": 0.3 },
               { "op": "color", "color": "carved_highlight" },
               { "op": "noise_tint", "amount": 0.08, "scale": 0.3 } ] },
    { "name": "capstone", "material": "carved_stone", "when": "tier >= 2",
      "shape": { "op": "box", "size": [1.2, 0.2, 1.2], "bevel": 0.05 },
      "ops": [ { "op": "move", "by": [0, "h - 0.02", 0] },
               { "op": "bevel_tint", "color": "carved_highlight", "amount": 0.9 } ] },
    { "name": "runes_front", "include": "rune_column", "params": { "count": "runes", "first": 1, "size": 0.38 },
      "ops": [ { "op": "move", "by": [0, "ring_y - 0.18", "face"] } ] },
    { "name": "runes_back", "include": "rune_column", "when": "tier >= 2", "params": { "count": "runes", "first": 3, "size": 0.38 },
      "ops": [ { "op": "rotate", "deg": [0, 180, 0] }, { "op": "move", "by": [0, "ring_y - 0.18", "-face"] } ] },
    { "name": "runes_right", "include": "rune_column", "when": "tier >= 3", "params": { "count": 3, "first": 0, "size": 0.38 },
      "ops": [ { "op": "rotate", "deg": [0, 90, 0] }, { "op": "move", "by": ["face", "ring_y - 0.18", 0] } ] },
    { "name": "runes_left", "include": "rune_column", "when": "tier >= 3", "params": { "count": 3, "first": 2, "size": 0.38 },
      "ops": [ { "op": "rotate", "deg": [0, -90, 0] }, { "op": "move", "by": ["-face", "ring_y - 0.18", 0] } ] },
    { "name": "halo", "material": "rune_glow", "when": "tier >= 3",
      "shape": { "op": "torus", "radius": 0.62, "tube": 0.045, "segments": 28, "sides": 6 },
      "ops": [ { "op": "rotate", "deg": [-8, 0, 5] }, { "op": "move", "by": [0, "h + 0.5", 0] } ] }
  ],
  "finish": [ { "op": "ground_shade", "amount": 0.35, "height": 0.5 } ]
}
