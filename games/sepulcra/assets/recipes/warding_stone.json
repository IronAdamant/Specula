{
  "recipe": 1,
  "name": "warding_stone",
  "category": "stone",
  "description": "Basic single-target stone. Upright 1.0 x 1.0 monolith with a pointed top (STYLE.md). Tier I: runes on the front; II: runes front and back plus a capstone collar; III: runes on all faces, taller, and a floating rune ring.",
  "seed": 101,
  "params": { "tier": { "default": 1, "min": 1, "max": 3, "integer": true } },
  "let": {
    "plinth": "0.18",
    "h": "tier >= 3 ? 2.6 : 2.4",
    "shoulder": "h - 0.62",
    "face": "0.508",
    "runes": "tier >= 2 ? 3 : 2"
  },
  "budget": { "max_triangles": "tier >= 3 ? 3000 : 1500" },
  "lods": [0.5, 0.25],
  "collider": "convex_hull",
  "smooth_angle": 25,
  "parts": [
    { "name": "plinth", "material": "carved_stone", "color": "carved_shadow",
      "shape": { "op": "box", "size": [1.34, "plinth", 1.34], "bevel": 0.06 },
      "ops": [
        { "op": "displace", "amount": 0.025, "scale": 0.5, "axes": [1, 0.3, 1] },
        { "op": "bevel_tint", "color": "carved_stone", "amount": 0.7 }
      ] },
    { "name": "body", "material": "carved_stone",
      "shape": { "op": "loft", "outline": { "rect": [1.0, 1.0], "bevel": 0.06 },
                 "stations": [[0.9, 0], [1.0, 0.06], [1.0, "shoulder - plinth"], [0.9, "shoulder - plinth + 0.06"], [0, "h - plinth"]] },
      "ops": [
        { "op": "move", "by": [0, "plinth", 0] },
        { "op": "gradient", "from": "carved_shadow", "to": "carved_stone", "range": [0, 0.45] },
        { "op": "bevel_tint", "color": "carved_highlight", "amount": 0.75 },
        { "op": "noise_tint", "amount": 0.07, "scale": 0.35 }
      ] },
    { "name": "capstone", "material": "carved_stone", "when": "tier >= 2",
      "shape": { "op": "box", "size": [1.14, 0.16, 1.14], "bevel": 0.045 },
      "ops": [
        { "op": "move", "by": [0, "shoulder - 0.14", 0] },
        { "op": "bevel_tint", "color": "carved_highlight", "amount": 0.9 }
      ] },
    { "name": "runes_front", "include": "rune_column", "params": { "count": "runes", "first": 0 },
      "ops": [ { "op": "move", "by": [0, "shoulder - 0.1", "face"] } ] },
    { "name": "runes_back", "include": "rune_column", "when": "tier >= 2", "params": { "count": "runes", "first": 2 },
      "ops": [ { "op": "rotate", "deg": [0, 180, 0] }, { "op": "move", "by": [0, "shoulder - 0.1", "-face"] } ] },
    { "name": "runes_right", "include": "rune_column", "when": "tier >= 3", "params": { "count": 3, "first": 1 },
      "ops": [ { "op": "rotate", "deg": [0, 90, 0] }, { "op": "move", "by": ["face", "shoulder - 0.1", 0] } ] },
    { "name": "runes_left", "include": "rune_column", "when": "tier >= 3", "params": { "count": 3, "first": 3 },
      "ops": [ { "op": "rotate", "deg": [0, -90, 0] }, { "op": "move", "by": ["-face", "shoulder - 0.1", 0] } ] },
    { "name": "halo", "material": "rune_glow", "when": "tier >= 3",
      "shape": { "op": "torus", "radius": 0.5, "tube": 0.045, "segments": 28, "sides": 6 },
      "ops": [ { "op": "rotate", "deg": [10, 0, 6] }, { "op": "move", "by": [0, "h + 0.38", 0] } ] }
  ],
  "finish": [ { "op": "ground_shade", "amount": 0.35, "height": 0.5 } ]
}
