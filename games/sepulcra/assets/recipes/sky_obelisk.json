{
  "recipe": 1,
  "name": "sky_obelisk",
  "category": "stone",
  "description": "Anti-air stone. 0.8 x 0.8 x 4 m tall needle (STYLE.md): straight rune-carved base, long taper, sharp tip. Tier I: runes on the front; II: front and back plus a capstone collar where the needle starts; III: all faces and a rune ring floating around the needle.",
  "seed": 404,
  "params": { "tier": { "default": 1, "min": 1, "max": 3, "integer": true } },
  "let": {
    "plinth": "0.24",
    "h": "4.0",
    "w": "0.8",
    "straight": "1.55",
    "face": "w / 2 + 0.008",
    "runes": "tier >= 2 ? 3 : 2"
  },
  "budget": { "max_triangles": "tier >= 3 ? 3000 : 1500" },
  "lods": [0.5, 0.25],
  "collider": "convex_hull",
  "smooth_angle": 25,
  "parts": [
    { "name": "plinth", "material": "carved_stone", "color": "carved_shadow",
