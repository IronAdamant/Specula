      "ops": [ { "op": "move", "by": [0, "plinth", 0] },
               { "op": "gradient", "from": "carved_shadow", "to": "carved_stone", "range": [0, 0.35] },
               { "op": "bevel_tint", "color": "carved_highlight", "amount": 0.75 },
               { "op": "noise_tint", "amount": 0.07, "scale": 0.35 } ] },
    { "name": "capstone", "material": "carved_stone", "when": "tier >= 2",
      "shape": { "op": "box", "size": [0.98, 0.14, 0.98], "bevel": 0.04 },
      "ops": [ { "op": "move", "by": [0, "plinth + straight - 0.06", 0] },
               { "op": "bevel_tint", "color": "carved_highlight", "amount": 0.9 } ] },
    { "name": "runes_front", "include": "rune_column", "params": { "count": "runes", "first": 2, "size": 0.36 },
      "ops": [ { "op": "move", "by": [0, "plinth + straight - 0.1", "face"] } ] },
    { "name": "runes_back", "include": "rune_column", "when": "tier >= 2", "params": { "count": "runes", "first": 0, "size": 0.36 },
      "ops": [ { "op": "rotate", "deg": [0, 180, 0] }, { "op": "move", "by": [0, "plinth + straight - 0.1", "-face"] } ] },
    { "name": "runes_right", "include": "rune_column", "when": "tier >= 3", "params": { "count": 3, "first": 3, "size": 0.36 },
      "ops": [ { "op": "rotate", "deg": [0, 90, 0] }, { "op": "move", "by": ["face", "plinth + straight - 0.1", 0] } ] },
    { "name": "runes_left", "include": "rune_column", "when": "tier >= 3", "params": { "count": 3, "first": 1, "size": 0.36 },
      "ops": [ { "op": "rotate", "deg": [0, -90, 0] }, { "op": "move", "by": ["-face", "plinth + straight - 0.1", 0] } ] },
    { "name": "tip_glow", "material": "rune_glow", "when": "tier >= 2", "lod_detail": 0,
      "shape": { "op": "loft", "outline": { "rect": [0.12, 0.12] }, "stations": [[1, 0], [0, 0.22]] },
      "ops": [ { "op": "move", "by": [0, "h - 0.13", 0] } ] },
    { "name": "halo", "material": "rune_glow", "when": "tier >= 3",
      "shape": { "op": "torus", "radius": 0.55, "tube": 0.04, "segments": 28, "sides": 6 },
      "ops": [ { "op": "rotate", "deg": [12, 0, 0] }, { "op": "move", "by": [0, "h - 1.0", 0] } ] }
  ],
  "finish": [ { "op": "ground_shade", "amount": 0.35, "height": 0.5 } ]
