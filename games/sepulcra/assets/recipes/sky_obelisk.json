                 "stations": [[0.94, 0], [1.0, 0.05], [1.0, 0.14], [0.86, 0.2], [0.86, "plinth"]] },
      "ops": [ { "op": "bevel_tint", "color": "carved_stone", "amount": 0.7 } ] },
    { "name": "needle", "material": "carved_stone",
