  "graphs": {
    "creature": {
      "note": "The game sets act, speed (world m/s), hit and the look target; the graph picks and blends the clips. Knee limits: straight is the rest bend backwards (33.8 deg).",
      "params": { "act": { "type": "enum", "values": ["idle", "move", "attack", "special", "death"] },
                  "speed": { "type": "float", "min": 0, "max": 20 },
                  "hit": "trigger",
                  "look_at": "vec3", "look": { "type": "float", "min": 0, "max": 1, "default": 0 } },
      "nodes": { "locomotion": { "blend1d": "speed", "points": [[0.35, "shuffle"], [0.8, "walk"]] } },
      "states": {
        "idle": "idle",
        "move": { "play": "locomotion", "match_speed": "speed" },
        "attack": "attack",
        "special": "attack",
        "death": { "play": "death", "ik": { "feet": 0, "look": 0 } } },
      "entry": "idle",
      "transitions": [
        { "from": "*", "to": "death", "when": "act == death", "blend": 0.25 },
        { "from": "*", "to": "move", "when": "act == move", "blend": 0.3 },
        { "from": "*", "to": "idle", "when": "act == idle", "blend": 0.35 },
        { "from": "*", "to": "attack", "when": "act == attack", "blend": 0.4 },
        { "from": "*", "to": "special", "when": "act == special", "blend": 0.4 },
        { "from": "attack", "to": "attack", "exit": "end", "blend": 0.05 } ],
      "layers": [ { "name": "flinch", "mode": "additive", "mask": "upper",
                    "states": { "calm": "still", "hit": "flinch" },
                    "transitions": [ { "from": "calm", "to": "hit", "when": "hit", "blend": 0 },
                                     { "from": "hit", "to": "calm", "exit": "end", "blend": 0 } ] } ],
      "ik": [ { "name": "feet", "kind": "feet", "pelvis": "hips", "max_step": 0.3, "max_drop": 0.3,
                "legs": [["thigh_l", "shin_l", "foot_l"], ["thigh_r", "shin_r", "foot_r"]] },
              { "name": "look", "kind": "look_at", "bones": ["chest", "head"], "share": [0.35, 0.65],
                "target": "look_at", "weight": "look", "limit": 45 } ],
      "limits": { "shin_l": { "x": [-33, 150] }, "shin_r": { "x": [-33, 150] } } }
  }
