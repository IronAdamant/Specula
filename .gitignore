# Rust
/target
**/target
**/*.rs.bk

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Env / secrets
.env
.env.*
!.env.example

# Scratch and logs
__pycache__/
*.log
.scratch/
tmp/

# Frames saved by `sight_frame` (engine working directory)
/captures/

# Local agent client settings (project .claude/agents stays tracked)
.claude/settings.local.json
# Machine-local agent notes (personal paths; auto-loaded by Claude Code)
CLAUDE.local.md
.grok/

# Tooling caches / local indexes (not product source)
.wikifier_staging/
.stele-context/
.chisel/
.trammel/
.coordinationhub/
.swarmnotes/
.probatio/
# Wikifier's local state at the root (journal, health, maps, dashboard) and agent-written wikis
/journal/
/file_health.md
/file_health.json
/pending_updates.md
/library.md
/map_paths.txt
/monitored_paths.txt
/index.html
*.wiki.md

# Subagent worktrees (Claude Code)
.claude/worktrees/

# Pipeline cache written by the engine
.specula-cache/

# Held by a running engine that owns a world folder
worlds/*/world.lock
# An unsaved world's review evidence (this run's; removed once the run is gone)
worlds/.review-unsaved-*/

# Full-size originals behind docs/gallery thumbnails (scripts/gallery.py), local only
/gallery-full/

# Save games written by engines run from the checkout (--saves defaults to ./saves)
/saves/
.specula-trace/

# Taste history is private (docs/design/GALLERIES.md "Privacy"): raw picks, notes, galleries,
# boards and onboarding state. What the human approved from them (style.toml, ui/theme.json,
# assets/style/) is tracked. Every default assets root's taste/ folder: the working directory's
# (a plain `cargo run -p specula`), any game's assets/ and Sepulcra's. A private project may
# track its history by removing these lines.
/taste/
**/assets/taste/
/games/sepulcra/assets/taste/
