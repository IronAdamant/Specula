 "brief": "Five pillars stand under /pillars, on both sides of a 4 m tall wall (/screen_wall). Create one of your named cameras, \"overview\" (camera_set), from which, in a 960x540 capture, every pillar is clearly visible: each one shows at least 300 pixels of itself in the capture (the ID buffer's visible_px, so what the wall or another pillar hides doesn't count). Don't move or change anything in the world.",
 "tools": [
  "camera_*",
  "sight_*",
  "world_query",
  "world_list"
 ],
 "limits": {
  "calls": 30,
  "wall_s": 600
 },
 "verify": [
  {
   "name": "nothing changed but what the task allows (world_diff against the world after setup)",
   "world_diff": {
    "allow": []
   }
  },
  {
   "name": "a camera named overview was set",
   "call": "world_history",
   "args": {
    "kinds": [
     "camera"
    ],
    "limit": 20
   },
   "save": "cams",
   "expect": {
    "entries.#": {
     "gte": 1
    }
   }
  },
  {
   "name": "through it, all five pillars show at least 300 px (visible_px)",
   "call": "sight_frame",
   "args": {
    "camera": "overview",
    "camera_of": "${cams.entries.0.by}",
    "width": 960,
    "height": 540
   },
   "select": {
    "from": "subjects",
    "where": {
     "path": {
      "contains": "/pillars/"
     },
     "visible_px": {
      "gte": 300
     },
     "occluded": {
      "exists": false
     },
     "no_pixels": {
      "exists": false
     }
    },
    "count": true
   },
   "expect": {
    "count": 5
   }
  },
  {
   "name": "the world wasn't changed",
   "call": "world_history",
   "args": {
    "kinds": [
     "spawn",
     "set",
     "delete",
     "batch"
    ],
    "limit": 20
   },
   "select": {
    "from": "entries",
    "where": {
     "by": {
      "ne": "setup"
     }
    },
    "count": true
   },
   "expect": {
    "count": 0
   }
  }
 ],
