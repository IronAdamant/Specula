      "tags": [
       "crate"
      ]
     },
     {
      "op": "spawn",
      "shape": "cube",
      "parent": "/crates",
      "name": "crate_3",
      "position": [
       3.5,
       0.5,
       -2
      ],
      "color": "#8a6a48",
      "tags": [
       "crate"
      ]
     },
     {
      "op": "spawn",
      "shape": "cube",
      "parent": "/crates",
      "name": "crate_4",
      "position": [
       0,
       0.5,
       -1
      ],
      "color": "#8a6a48",
      "tags": [
       "crate"
      ]
     },
     {
      "op": "spawn",
