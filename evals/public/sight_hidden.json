{
 "eval": 1,
 "id": "sight_hidden",
 "set": "public",
 "area": "sight",
 "title": "Find what a camera can't see",
 "summary": "Sight as data: use the ID buffer (visible_px, occluded) to tell fully hidden, partly hidden and visible crates apart, then tag them.",
 "game": null,
 "setup": [
  {
   "as": "setup",
   "call": "world_batch",
   "args": {
    "ops": [
     {
      "op": "spawn",
      "shape": "cube",
