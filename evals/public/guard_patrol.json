       24
      ],
      "color": "#8c8f96",
      "collider": {
       "shape": "box"
      }
     },
     {
      "op": "spawn",
      "shape": "cube",
      "name": "wall_east",
      "position": [
       12.2,
       1.25,
       0
      ],
      "scale": [
       0.4,
