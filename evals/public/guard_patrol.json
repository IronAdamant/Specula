{
 "eval": 1,
 "id": "guard_patrol",
 "set": "public",
 "area": "ai",
 "title": "Make a guard patrol its room",
 "summary": "Navigation and AI as data: a navmesh that fits the character, a mind (behaviour tree) that patrols waypoints, checked by stepping 20 s and sampling where the guard goes. Needs nav_build and ai_set (the navigation and Locus lane).",
 "game": null,
 "needs": [
  "nav_build",
  "ai_set",
  "nav_info",
  "ai_status"
 ],
 "setup": [
  {
   "as": "setup",
   "call": "world_batch",
   "args": {
