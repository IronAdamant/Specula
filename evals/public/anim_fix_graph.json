{
 "eval": 1,
 "id": "anim_fix_graph",
 "set": "public",
 "area": "animation",
 "title": "Fix an animation graph that motion checks flag",
 "summary": "Motion checks as data: a teammate's edit made the shambler's feet slide and its transitions pop; the agent reads anim_check's errors and repairs the graph in place (journaled, not deleted).",
 "game": "sepulcra",
 "setup": [
  {
   "as": "animator",
   "call": "model_build",
   "args": {
    "recipe": "recipes/shambler.json"
   }
  },
  {
   "as": "animator",
   "call": "anim_set",
   "args": {
    "recipe": "recipes/shambler.json",
    "name": "creature",
    "patch": {
     "states": {
      "move": {
       "play": "locomotion",
       "match_speed": null,
       "speed": 2.2
      }
     },
     "transitions": [
      {
       "from": "*",
       "to": "ragdoll",
       "when": "ragdoll",
       "blend": 0.12
      },
      {
       "from": "ragdoll",
       "to": "getup",
       "when": "!ragdoll",
       "blend": 0.8
      },
      {
       "from": "getup",
       "to": "death",
       "when": "act == death",
       "exit": 0.25,
       "blend": 0.25
      },
      {
       "from": "getup",
       "to": "move",
       "when": "act == move",
       "exit": 0.25,
       "blend": 0.4
      },
      {
       "from": "getup",
       "to": "idle",
       "when": "act == idle",
       "exit": 0.25,
       "blend": 0.35
      },
      {
       "from": "getup",
       "to": "attack",
       "when": "act == attack",
       "exit": 0.25,
       "blend": 0.4
      },
      {
       "from": "getup",
       "to": "special",
       "when": "act == special",
       "exit": 0.25,
       "blend": 0.6
      },
      {
       "from": [
        "idle",
        "move",
        "attack",
        "special"
       ],
       "to": "death",
       "when": "act == death and !ragdoll",
       "blend": 0.25
      },
      {
       "from": [
        "idle",
        "attack",
        "special",
        "death"
       ],
       "to": "move",
       "when": "act == move and !ragdoll",
       "blend": 0
      },
      {
       "from": [
        "move",
        "attack",
        "special",
        "death"
       ],
       "to": "idle",
       "when": "act == idle and !ragdoll",
       "blend": 0.35
      },
      {
       "from": [
        "idle",
        "move",
        "special",
        "death"
       ],
       "to": "attack",
       "when": "act == attack and !ragdoll",
       "blend": 0
      },
      {
       "from": [
        "idle",
        "move",
        "attack",
        "death"
       ],
       "to": "special",
       "when": "act == special and !ragdoll",
       "blend": 0.6
      },
      {
       "from": "attack",
       "to": "attack",
       "exit": "end",
       "blend": 0.05
      }
     ]
    }
   }
  }
 ],
 "brief": "The engine hosts Sepulcra. Another agent (\"animator\") edited the shambler's animation graph \"creature\" (model recipes/shambler.json) live, and the motion checks now fail: anim_check flags foot sliding in the \"move\" state and pops in the transitions idle -> move and move -> attack (check with states [{\"state\": \"move\", \"params\": {\"act\": \"move\", \"speed\": 0.8}}] and transitions [{\"from\": {\"act\": \"idle\"}, \"to\": {\"act\": \"move\", \"speed\": 0.8}}, {\"from\": {\"act\": \"move\", \"speed\": 0.8}, \"to\": {\"act\": \"attack\"}}]). Repair the graph so those checks pass at any walking speed. Keep every state, transition and the flinch layer, and fix the world's version of the graph rather than deleting it.",
 "tools": [
  "anim_*",
  "model_build",
  "world_query",
  "world_history",
  "sight_frame"
 ],
 "limits": {
  "calls": 30,
  "wall_s": 900
 },
 "verify": [
  {
   "name": "nothing changed but what the task allows (world_diff against the world after setup)",
   "world_diff": {
    "allow": [
     {
      "path": "/anims*"
     }
    ]
   }
  },
  {
   "name": "anim_check passes: move at 0.8 m/s, idle->move and move->attack",
   "call": "anim_check",
   "args": {
    "recipe": "recipes/shambler.json",
    "clips": [],
    "states": [
     {
      "state": "move",
      "params": {
       "act": "move",
       "speed": 0.8
      }
     }
    ],
    "transitions": [
     {
      "from": {
       "act": "idle"
      },
      "to": {
       "act": "move",
       "speed": 0.8
      }
     },
     {
      "from": {
       "act": "move",
       "speed": 0.8
      },
      "to": {
       "act": "attack"
      }
     }
    ]
   },
   "expect": {
    "passed": true,
    "errors.#": 0
   }
  },
  {
   "name": "and at other walking speeds (0.5 and 1.6 m/s)",
   "call": "anim_check",
   "args": {
    "recipe": "recipes/shambler.json",
    "clips": [],
    "states": [
     {
      "state": "move",
      "params": {
       "act": "move",
       "speed": 0.5
      }
     },
     {
      "state": "move",
      "params": {
       "act": "move",
       "speed": 1.6
      }
     }
    ]
   },
   "expect": {
    "passed": true
   }
  },
  {
   "name": "the graph still has its 7 states (ragdoll and getup included), 13 transitions and the flinch layer",
   "call": "anim_get",
   "args": {
    "recipe": "recipes/shambler.json",
    "graph": "creature"
   },
   "expect": {
    "graph.states.#": 7,
    "graph.states.ragdoll": {
     "exists": true
    },
    "graph.states.getup": {
     "exists": true
    },
    "graph.transitions.#": 13,
    "graph.layers.0.name": "flinch",
    "graph.layers.0.states.#": 2
   }
  },
  {
   "name": "the world's graph asset is fixed in place, not deleted",
   "call": "world_query",
   "args": {
    "tags": [
     "anim_asset"
    ],
    "fields": [
     "path"
    ]
   },
   "select": {
    "from": "items",
    "where": {
     "path": {
      "contains": "graphs/creature"
     }
    },
    "count": true
   },
   "expect": {
    "count": 1
   }
  }
 ],
