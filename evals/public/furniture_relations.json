 ],
 "brief": "Furnish the room at /room (inside: x -4..4, z -3..3, floor top at y = 0, a 1.2 m doorway in the middle of the south wall at z = 3). Put the furniture under /room/furniture:\n- a table (tag \"table\", 1.6 x 0.75 x 0.8 m, box collider) with its back against the north wall's inner face (z = -3), within 0.5 m of the room's centre line (x = 0), standing on the floor;\n- four chairs (tag \"chair\", 0.5 m cubes, box colliders, dynamic bodies of 8 kg) on the floor around the table, each between 0.4 and 1.2 m from it and at least 0.8 m from each other, all facing the table;\n- nothing within 1 m of the doorway, and nothing overlapping anything else.\nThe engine can solve placements from relations (world_place) so you don't have to compute coordinates.",
 "tools": [
  "world_*",
  "physics_*",
  "sight_frame",
  "time_control"
 ],
 "limits": {
  "calls": 30,
  "wall_s": 600
 },
 "verify": [
  {
   "name": "nothing changed but what the task allows (world_diff against the world after setup)",
   "world_diff": {
    "allow": [
     {
      "path": "/room/furniture",
      "ops": [
       "added"
      ]
     },
     {
      "path": "/room/furniture/*",
      "ops": [
       "added"
      ]
     }
    ]
   }
  },
  {
   "name": "one table, its back on the north wall's face, near the centre line, on the floor",
   "call": "world_query",
   "args": {
    "path_prefix": "/room/furniture",
    "tags": [
     "table"
    ],
    "fields": [
     "path",
     "bounds",
     "world_position"
    ]
   },
   "expect": {
    "total": 1,
    "items.0.bounds.min.2": {
     "near": -3,
     "tol": 0.03
    },
    "items.0.world_position.0": {
     "near": 0,
     "tol": 0.5
    },
    "items.0.bounds.min.1": {
     "near": 0,
     "tol": 0.02
    }
   }
  },
  {
   "name": "four chairs on the floor, within 1.2 m of the table's footprint",
   "call": "world_query",
   "args": {
    "path_prefix": "/room/furniture",
    "tags": [
     "chair"
    ],
    "fields": [
     "path",
     "bounds",
     "body"
    ]
   },
   "select": {
    "from": "items",
    "where": {
     "bounds.min.1": {
      "near": 0,
      "tol": 0.03
     },
     "bounds.min.0": {
      "gte": -2.1
     },
     "bounds.max.0": {
      "lte": 2.1
     },
     "bounds.min.2": {
      "gte": -3
     },
     "bounds.max.2": {
      "lte": -0.4
     },
     "body.kind": "dynamic"
    },
    "count": true
   },
   "expect": {
    "count": 4
   }
  },
  {
   "name": "the chairs are spread apart (bounds at least 0.55 m apart: 0.8 m between footprints, less what a turned chair's box adds)",
   "geometry": {
    "kind": "min_gap",
    "query": {
     "path_prefix": "/room/furniture",
     "tags": [
      "chair"
     ]
    },
    "min": 0.55,
    "min_count": 4
   }
  },
  {
   "name": "every chair faces the table (within 30 degrees)",
   "geometry": {
    "kind": "facing",
    "query": {
     "path_prefix": "/room/furniture",
     "tags": [
      "chair"
     ]
    },
    "target": "/room/furniture/table",
    "max_deg": 30,
    "min_count": 4
   }
  },
  {
   "name": "every chair is a 0.5 m cube in the world (through its parents' scale)",
   "geometry": {
    "kind": "world_size",
    "query": {
     "path_prefix": "/room/furniture",
     "tags": [
      "chair"
     ]
    },
    "size": [
     0.5,
     0.5,
     0.5
    ],
    "tol": 0.03,
    "min_count": 4
   }
  },
  {
   "name": "the table is 1.6 x 0.75 x 0.8 m",
   "geometry": {
    "kind": "size",
    "query": {
     "path_prefix": "/room/furniture",
     "tags": [
      "table"
     ]
    },
    "size": [
     1.6,
     0.75,
     0.8
    ],
    "tol": 0.03
   }
  },
  {
   "name": "the doorway is clear for 1 m",
   "call": "time_control",
   "args": {
    "action": "step",
    "ticks": 1
   }
  },
  {
   "name": "nothing in the doorway's metre",
   "call": "physics_overlap",
   "args": {
    "shape": {
     "shape": "box",
     "size": [
      3.2,
      1.4,
      1.9
     ]
    },
    "at": [
     0,
     0.8,
     1.95
    ]
   },
   "expect": {
    "total": 0
   }
  },
  {
   "name": "a second of physics: nothing overlaps, all at rest",
   "playtest": {
    "name": "furniture_settles",
    "ticks": 30,
    "end": [
     {
      "call": "physics_check",
      "args": {
       "checks": [
        {
         "check": "no_penetration",
         "max_depth": 0.01
        },
        {
         "check": "at_rest",
         "entities": "/room/furniture"
        }
       ]
      },
      "expect": {
       "pass": true
      }
     },
     {
      "call": "sight_frame",
      "args": {
       "eye": [
        0,
        7,
        6
       ],
       "target": [
        0,
        0,
        -1
       ],
       "width": 640,
       "height": 400
      },
      "label": "furnished"
     }
    ]
   }
  }
 ],
