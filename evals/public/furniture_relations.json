{
 "eval": 1,
 "id": "furniture_relations",
 "set": "public",
 "area": "locus",
 "title": "Furnish a room by relations",
 "summary": "Placement by relations (Locus): a table against a wall, chairs around it with spacing, the doorway kept clear; checked by bounds, physics overlap and a short simulation (nothing interpenetrates). Needs world_place (the navigation and Locus lane).",
 "game": null,
 "needs": [
  "world_place"
 ],
 "setup": [
  {
   "as": "setup",
   "call": "world_batch",
   "args": {
    "ops": [
     {
      "op": "spawn",
      "shape": "group",
      "name": "room"
     },
     {
      "op": "spawn",
      "shape": "cube",
