  {
   "name": "wall above the doorway (lintel below 2.3 m)",
   "call": "physics_raycast",
   "args": {
    "origin": [
     0,
     2.3,
     0
    ],
    "direction": [
     0,
     0,
     1
    ],
    "max_distance": 10
   },
   "expect": {
    "hits.0.distance": {
     "near": 2,
     "tol": 0.03
    }
   }
  },
  {
   "name": "the floor's top is at y = 0",
   "call": "physics_raycast",
   "args": {
    "origin": [
     1,
     1,
     1
    ],
    "direction": [
     0,
     -1,
     0
    ],
    "max_distance": 10
   },
   "expect": {
    "hits.0.distance": {
     "near": 1,
     "tol": 0.02
    },
    "hits.0.path": {
     "contains": "/room/"
    }
   }
  },
  {
   "name": "the walls are 3 m tall (east wall top)",
   "call": "physics_raycast",
   "args": {
    "origin": [
     3.05,
     5,
     0
    ],
    "direction": [
     0,
     -1,
     0
    ],
    "max_distance": 10
   },
   "expect": {
    "hits.0.distance": {
     "near": 2,
     "tol": 0.03
    }
   }
  },
  {
   "name": "one lamp with a point light, inside the room, 2-3 m up",
   "call": "world_query",
   "args": {
    "path_prefix": "/room",
    "tags": [
     "lamp"
    ],
    "fields": [
     "path",
     "world_position",
     "light"
    ]
   },
   "expect": {
    "total": 1,
    "items.0.light": {
     "exists": true
    },
    "items.0.world_position.1": {
     "gte": 2,
     "lte": 3
    },
    "items.0.world_position.0": {
     "gt": -3,
     "lt": 3
    },
    "items.0.world_position.2": {
     "gt": -2,
     "lt": 2
    }
   }
  },
  {
   "name": "a capture through the doorway shows the room",
   "call": "sight_frame",
   "args": {
    "eye": [
     0,
     1.6,
     7
    ],
    "target": [
     0,
     1.2,
     0
    ],
    "width": 640,
    "height": 400,
    "subjects": "visible"
   },
   "select": {
    "from": "subjects",
    "where": {
     "path": {
      "contains": "/room/"
     }
    },
    "count": true
   },
   "expect": {
    "count": {
     "gte": 4
    }
   }
  }
 ],
