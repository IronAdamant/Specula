{
 "eval": 1,
 "id": "room_build",
 "set": "public",
 "area": "world",
 "title": "Build a room with a doorway and a lamp",
 "summary": "World building from a written spec: floor, four walls, a doorway, a lamp; checked by physics rays, queries and a capture.",
 "game": null,
 "brief": "Build a small room in an empty world. Put every piece under one group at /room.\n- Floor: covers x -3..3 and z -2..2, its top surface at y = 0.\n- Walls: 3 m tall (from y = 0 to y = 3), on all four sides, with their inner faces exactly at x = -3, x = 3, z = -2 and z = 2.\n- Doorway: a gap 1.2 m wide (x -0.6..0.6) and 2.1 m tall (y 0..2.1) in the south wall (the z = 2 side), with wall above it.\n- Lamp: one entity tagged \"lamp\" that carries a point light, inside the room between 2 and 3 m up.\nThe floor and every wall piece need a box collider (the engine checks the room with physics rays).",
 "tools": [
  "world_*",
  "sight_frame",
  "physics_raycast",
  "physics_overlap",
  "time_control"
 ],
 "limits": {
  "calls": 40,
  "wall_s": 600
 },
 "verify": [
  {
   "name": "nothing changed but what the task allows (world_diff against the world after setup)",
   "world_diff": {
    "allow": [
     {
      "path": "/room",
      "ops": [
       "added"
      ]
     },
     {
      "path": "/room/*",
      "ops": [
       "added"
      ]
     }
    ]
   }
  },
  {
   "name": "a physics tick so the colliders are current",
   "call": "time_control",
   "args": {
    "action": "step",
    "ticks": 1
   }
  },
  {
   "name": "east wall inner face at x = 3",
   "call": "physics_raycast",
   "args": {
    "origin": [
     0,
     1,
     0
    ],
    "direction": [
     1,
     0,
     0
    ],
    "max_distance": 10
   },
   "expect": {
    "hits.0.distance": {
     "near": 3,
     "tol": 0.03
    },
    "hits.0.path": {
     "contains": "/room/"
    }
   }
  },
  {
   "name": "west wall inner face at x = -3",
   "call": "physics_raycast",
   "args": {
    "origin": [
     0,
     1,
     0
    ],
    "direction": [
     -1,
     0,
     0
    ],
    "max_distance": 10
   },
   "expect": {
    "hits.0.distance": {
     "near": 3,
     "tol": 0.03
    },
    "hits.0.path": {
     "contains": "/room/"
    }
   }
  },
  {
   "name": "north wall inner face at z = -2",
   "call": "physics_raycast",
   "args": {
    "origin": [
     0,
     1,
     0
    ],
    "direction": [
     0,
     0,
     -1
    ],
    "max_distance": 10
   },
   "expect": {
    "hits.0.distance": {
     "near": 2,
     "tol": 0.03
    },
    "hits.0.path": {
     "contains": "/room/"
    }
   }
  },
  {
   "name": "south wall beside the doorway at z = 2",
   "call": "physics_raycast",
   "args": {
    "origin": [
     1.5,
     1,
     0
    ],
    "direction": [
     0,
     0,
     1
    ],
    "max_distance": 10
   },
   "expect": {
    "hits.0.distance": {
     "near": 2,
     "tol": 0.03
    }
   }
  },
  {
   "name": "the doorway is open (a ray through it hits nothing)",
   "call": "physics_raycast",
   "args": {
    "origin": [
     0,
     1,
     0
    ],
    "direction": [
     0,
     0,
     1
    ],
    "max_distance": 20
   },
   "expect": {
    "total": 0
   }
  },
  {
   "name": "the doorway is 1.2 m wide (rays at x = +-0.5 pass, at +-0.7 hit)",
